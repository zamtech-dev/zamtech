---
import Layout from "../layouts/Layout.astro";
import CardPlano from "../components/CardPlano.astro";
import "../styles/global.css";

// Mesmos planos e adicionais de /planos-residenciais (CardPlano.astro é o
// mesmo componente, só que aqui com modo="selecionar" — em vez de mandar
// pro WhatsApp, o botão avança pra etapa de pré-cadastro com o plano e os
// adicionais escolhidos). Se um preço mudar lá, precisa mudar aqui também
// — são dois lugares por enquanto.
const adicionaisResidencial = [
    { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 39.90 },
    { nome: "Câmera Inteligente", preco: 39.90 },
    { nome: "Linha Telefônica Fixa", preco: 29.90 }
];
---

<!-- CONTRATAR EM ETAPAS — inspirado no fluxo da Nio (CEP -> escolhe o plano
     -> dados de contato -> confirmação), adaptado pro processo da Zamtech:
     a etapa final não é pagamento (a gente não cobra pelo site), é avisar a
     Carol pelo WhatsApp que o pré-cadastro já foi enviado, com o plano
     escolhido. Chega aqui de duas formas: direto (digita o CEP na etapa 1)
     ou vindo da busca de viabilidade da home, que já manda ?cep=&numero= na
     URL — nesse caso a etapa 1 confere de novo (nunca confia cegamente num
     link) e já pula pra etapa 2 se dermos certo. -->
<Layout title="Contratar Zamtech - Fibra Óptica em poucos passos">
    <section class="section-dark section contratar-hero">
        <div class="container contratar-hero-content">
            <span class="chip-brand">Contratação rápida</span>
            <h1>Vamos deixar sua internet <span class="text-gradient">pronta em poucos passos</span></h1>
            <p class="contratar-hero-subtitle">
                Confirma seu endereço, escolhe o plano e manda seus dados — nosso time comercial entra em contato pra agendar a instalação.
            </p>

            <ol class="wizard-steps" id="wizardSteps">
                <li class="wizard-step is-active" data-step="1">
                    <span class="wizard-step-num">1</span>
                    <span class="wizard-step-label">Endereço</span>
                </li>
                <li class="wizard-step" data-step="2">
                    <span class="wizard-step-num">2</span>
                    <span class="wizard-step-label">Plano</span>
                </li>
                <li class="wizard-step" data-step="3">
                    <span class="wizard-step-num">3</span>
                    <span class="wizard-step-label">Seus dados</span>
                </li>
                <li class="wizard-step" data-step="4">
                    <span class="wizard-step-num">4</span>
                    <span class="wizard-step-label">Pronto</span>
                </li>
            </ol>
        </div>
    </section>

    <section class="section form-section">
        <div class="container">
            <div class="form-wrapper card-padrao">

                <!-- ===================== ETAPA 1 — ENDEREÇO ===================== -->
                <div class="wizard-panel" id="painelEtapa1">
                    <h2>Confirma seu endereço</h2>
                    <p class="wizard-panel-subtitulo">Assim já sabemos se a fibra da Zamtech chega até você.</p>

                    <div class="input-row">
                        <div class="input-group">
                            <label for="etapa1Cep">CEP</label>
                            <input type="text" id="etapa1Cep" required placeholder="00000-000" inputmode="numeric" maxlength="9" autocomplete="off" />
                        </div>
                        <div class="input-group">
                            <label for="etapa1Numero">Número</label>
                            <input type="text" id="etapa1Numero" required placeholder="Nº" maxlength="7" autocomplete="off" />
                        </div>
                    </div>

                    <p id="etapa1Status" class="input-dica" hidden></p>

                    <button type="button" id="btnEtapa1Continuar" class="btn btn-primary btn-lg">Verificar e continuar</button>

                    <div id="etapa1SemCobertura" class="wizard-sem-cobertura" hidden>
                        <p id="etapa1SemCoberturaMsg"></p>
                        <form id="formLeadEtapa1" class="lead-form-etapa1">
                            <input type="text" name="nome" placeholder="Seu nome" required />
                            <input type="text" name="contato" placeholder="WhatsApp ou email" required />
                            <button type="submit" class="btn btn-primary">Quero ser avisado</button>
                        </form>
                        <p id="etapa1LeadConfirmacao" class="wizard-lead-confirmacao" hidden>Prontinho! Anotamos seu contato e te avisamos assim que tiver novidade.</p>
                    </div>
                </div>

                <!-- ===================== ETAPA 2 — PLANO ===================== -->
                <div class="wizard-panel" id="painelEtapa2" hidden>
                    <h2>Qual combina com você?</h2>
                    <p class="wizard-panel-subtitulo">Isso é só uma referência pra gente — nosso time confirma tudo certinho na ligação.</p>

                    <!-- Só planos residenciais aqui — o filtro Residencial/Empresarial
                         que existia poluía demais essa etapa do wizard. Empresas
                         continuam com /planos-empresariais só pra elas. -->
                    <div class="planos-toggle" id="subtoggleResidencial">
                        <button type="button" class="planos-toggle-btn is-active" id="btnPlanosCombos">Melhores Planos (Combos)</button>
                        <button type="button" class="planos-toggle-btn" id="btnPlanosEntrada">Planos de Entrada</button>
                    </div>

                    <div class="planos-grid" id="planosGridCombos">
                        <CardPlano
                            nome="ZAMTECH 800 - Ultra Mesh"
                            velocidade="800 Mega + Wi-Fi na Casa Toda"
                            precoBase={129.90}
                            badge="RECOMENDADO PARA CASAS MAIORES"
                            isFeatured={true}
                            modo="selecionar"
                            recursos={[
                                "1 Ponto Extra Wi-Fi Mesh Incluso",
                                "Zero pontos cegos ou sinal caindo",
                                "Instalação e Suporte Técnico inclusos"
                            ]}
                            adicionais={[
                                { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 0, incluso: true },
                                { nome: "Câmera Inteligente", preco: 39.90 },
                                { nome: "Linha Telefônica Fixa", preco: 29.90 }
                            ]}
                        />
                        <CardPlano
                            nome="ZAMTECH 800 - Ultra Secure"
                            velocidade="800 Mega + Câmera em Nuvem"
                            precoBase={139.90}
                            badge="COMBO SEGURANÇA RESIDENCIAL"
                            modo="selecionar"
                            recursos={[
                                "1 Câmera de Monitoramento em comodato",
                                "Gravação de vídeo 100% salva na nuvem",
                                "Acesso ao vivo pelo App Zamtech"
                            ]}
                            adicionais={[
                                { nome: "Câmera Inteligente", preco: 0, incluso: true },
                                { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 39.90 },
                                { nome: "Linha Telefônica Fixa", preco: 29.90 }
                            ]}
                        />
                        <CardPlano
                            nome="PLANO GAMER 1G"
                            velocidade="1 Giga + Wi-Fi 6 Especial"
                            precoBase={179.90}
                            badge="PERFORMANCE MÁXIMA"
                            isFeatured={true}
                            modo="selecionar"
                            recursos={[
                                "Roteador com tecnologia Wi-Fi 6",
                                "IP Público Incluso para servidores e jogos",
                                "Baixíssima latência para partidas sem lag"
                            ]}
                            adicionais={[
                                { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 39.90 },
                                { nome: "Câmera Inteligente", preco: 39.90 },
                                { nome: "Linha Telefônica Fixa", preco: 29.90 }
                            ]}
                        />
                    </div>

                    <div class="planos-grid hidden" id="planosGridEntrada">
                        <CardPlano
                            nome="ZAMTECH 300 - Play"
                            velocidade="300 Mega"
                            precoBase={79.90}
                            modo="selecionar"
                            recursos={[
                                "Ideal para até 5 aparelhos conectados",
                                "Suporte rápido e humanizado"
                            ]}
                            adicionais={adicionaisResidencial}
                        />
                        <CardPlano
                            nome="ZAMTECH 500 - Stream"
                            velocidade="500 Mega"
                            precoBase={89.90}
                            badge="MAIS POPULAR DA CATEGORIA"
                            isFeatured={true}
                            modo="selecionar"
                            recursos={[
                                "Excelente para Smart TVs em 4K",
                                "Ideal para até 10 aparelhos conectados"
                            ]}
                            adicionais={adicionaisResidencial}
                        />
                        <CardPlano
                            nome="ZAMTECH 800 - Ultra"
                            velocidade="800 Mega"
                            precoBase={99.90}
                            modo="selecionar"
                            recursos={[
                                "Conecta mais de 15 aparelhos sem perda",
                                "Download ultrarrápido de arquivos pesados"
                            ]}
                            adicionais={adicionaisResidencial}
                        />
                    </div>

                    <button type="button" id="btnEtapa2Voltar" class="btn btn-outlined-light">Voltar</button>
                </div>

                <!-- ===================== ETAPA 3 — DADOS DE CONTATO ===================== -->
                <div class="wizard-panel" id="painelEtapa3" hidden>
                    <h2>Seus dados</h2>
                    <p class="wizard-plano-resumo" id="resumoPlanoEscolhido"></p>

                    <form id="formContratar" class="contratar-form">
                        <div class="input-row">
                            <div class="input-group">
                                <label for="nome">Nome completo</label>
                                <input type="text" id="nome" required placeholder="Digite seu nome completo" autocomplete="name" />
                            </div>
                            <div class="input-group">
                                <label for="dataNascimento">Data de nascimento</label>
                                <input type="date" id="dataNascimento" required />
                            </div>
                        </div>

                        <div class="input-row">
                            <div class="input-group">
                                <label for="cpf">CPF</label>
                                <input type="text" id="cpf" required placeholder="000.000.000-00" inputmode="numeric" maxlength="14" autocomplete="off" />
                                <span class="input-erro" id="cpfErro" hidden>CPF inválido. Confira os números digitados.</span>
                            </div>
                            <div class="input-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" required placeholder="seuemail@exemplo.com" autocomplete="email" />
                            </div>
                        </div>

                        <div class="input-row">
                            <div class="input-group">
                                <label for="telefone1">Celular (WhatsApp)</label>
                                <input type="text" id="telefone1" required placeholder="(00) 00000-0000" inputmode="numeric" maxlength="15" autocomplete="tel" />
                            </div>
                            <div class="input-group">
                                <label for="telefone2">2º telefone</label>
                                <input type="text" id="telefone2" required placeholder="(00) 00000-0000" inputmode="numeric" maxlength="15" autocomplete="tel" />
                            </div>
                        </div>

                        <div class="input-row">
                            <div class="input-group">
                                <label for="estadoCivil">Estado civil</label>
                                <select id="estadoCivil" required>
                                    <option value="" selected disabled>Selecione</option>
                                    <option value="S">Solteiro(a)</option>
                                    <option value="C">Casado(a)</option>
                                    <option value="D">Divorciado(a)</option>
                                    <option value="V">Viúvo(a)</option>
                                </select>
                            </div>
                            <div class="input-group">
                                <label for="sexo">Sexo</label>
                                <select id="sexo" required>
                                    <option value="" selected disabled>Selecione</option>
                                    <option value="M">Masculino</option>
                                    <option value="F">Feminino</option>
                                </select>
                            </div>
                        </div>

                        <p class="secao-titulo">Endereço de instalação</p>
                        <p class="input-dica" id="enderecoConfirmadoResumo"></p>

                        <div class="input-group">
                            <label for="complemento">Complemento (opcional)</label>
                            <input type="text" id="complemento" placeholder="Apto, bloco..." autocomplete="off" />
                        </div>

                        <div class="input-group">
                            <label for="pontoReferencia">Ponto de referência (opcional)</label>
                            <input type="text" id="pontoReferencia" placeholder="Ex: ao lado do mercado tal" autocomplete="off" />
                        </div>

                        <div class="input-group">
                            <label for="diaVencimento">Dia de vencimento da fatura</label>
                            <select id="diaVencimento" required>
                                <option value="" selected disabled>Escolha um dia entre 1 e 25</option>
                            </select>
                        </div>

                        <label class="checkbox-group">
                            <input type="checkbox" id="aceite" required />
                            <span>Li e concordo com a <a href="/politica-de-privacidade" target="_blank">Política de Privacidade</a> da Zamtech e entendo que a contratação com fidelidade é mediante aprovação.</span>
                        </label>

                        <div class="wizard-form-botoes">
                            <button type="button" id="btnEtapa3Voltar" class="btn btn-outlined-light">Voltar</button>
                            <button type="submit" class="btn btn-primary btn-lg" id="btnEnviarContratar">Enviar pré-cadastro</button>
                        </div>
                    </form>

                    <div id="mensagemContratar" class="mensagem-retorno-precadastro hidden"></div>
                </div>

                <!-- ===================== ETAPA 4 — PRONTO ===================== -->
                <div class="wizard-panel wizard-panel--final" id="painelEtapa4" hidden>
                    <div class="wizard-final-icone">🎉</div>
                    <h2>Pré-cadastro enviado!</h2>
                    <p id="etapa4Mensagem">Recebemos seus dados. Agora é só avisar a gente no WhatsApp que você já se cadastrou, pra agilizar sua instalação.</p>
                    <a id="btnWhatsappFinal" href="https://wa.me/5527995057736" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Chamar no WhatsApp</a>
                </div>

            </div>
        </div>
    </section>
</Layout>

<script>
    // ---------- Plano escolhido ----------
    // Os cards em si (com os adicionais/switches) são o mesmo componente
    // CardPlano.astro usado em /planos-residenciais — aqui com modo=
    // "selecionar", então em vez de montar link de WhatsApp sozinho, cada
    // card dispara "zamtech:plano-selecionado" (ver CardPlano.astro) com o
    // plano já calculado (preço final incluindo os adicionais marcados).
    type PlanoSelecionado = { nome: string; velocidade: string; precoFinal: number; adicionais: string[] };

    let planoEscolhido: PlanoSelecionado | null = null;
    let enderecoConfirmado: { cep: string; logradouro: string; numero: string; bairro: string; cidade: string; uf: string } | null = null;

    // ---------- Navegação entre etapas ----------
    const paineis: Record<number, HTMLElement> = {
        1: document.getElementById("painelEtapa1") as HTMLElement,
        2: document.getElementById("painelEtapa2") as HTMLElement,
        3: document.getElementById("painelEtapa3") as HTMLElement,
        4: document.getElementById("painelEtapa4") as HTMLElement,
    };
    const stepIndicadores = document.querySelectorAll("#wizardSteps .wizard-step");
    const formWrapper = document.querySelector(".form-wrapper") as HTMLDivElement;

    function irParaEtapa(numero: number) {
        for (const [n, painel] of Object.entries(paineis)) {
            painel.hidden = Number(n) !== numero;
        }
        stepIndicadores.forEach((el) => {
            const passoEl = el as HTMLElement;
            const passo = Number(passoEl.dataset.step);
            passoEl.classList.toggle("is-active", passo === numero);
            passoEl.classList.toggle("is-done", passo < numero);
        });
        // Etapa 2 (escolha de plano) precisa de mais espaço horizontal pros
        // cards do CardPlano não ficarem espremidos — as outras etapas são
        // formulário e ficam melhor na largura estreita de sempre.
        formWrapper.classList.toggle("form-wrapper--largo", numero === 2);
        window.scrollTo({ top: 0, behavior: "smooth" });
    }

    // ---------- ETAPA 1: CEP + número ----------
    const etapa1Cep = document.getElementById("etapa1Cep") as HTMLInputElement;
    const etapa1Numero = document.getElementById("etapa1Numero") as HTMLInputElement;
    const etapa1Status = document.getElementById("etapa1Status") as HTMLParagraphElement;
    const btnEtapa1Continuar = document.getElementById("btnEtapa1Continuar") as HTMLButtonElement;
    const etapa1SemCobertura = document.getElementById("etapa1SemCobertura") as HTMLDivElement;
    const etapa1SemCoberturaMsg = document.getElementById("etapa1SemCoberturaMsg") as HTMLParagraphElement;

    function mostrarStatusEtapa1(texto: string, tipo: "ok" | "erro") {
        etapa1Status.textContent = texto;
        etapa1Status.className = `input-dica${tipo === "erro" ? " input-dica--erro" : ""}`;
        etapa1Status.hidden = false;
    }

    etapa1Cep.addEventListener("input", () => {
        const digitos = etapa1Cep.value.replace(/\D/g, "").slice(0, 8);
        etapa1Cep.value = digitos.length > 5 ? `${digitos.slice(0, 5)}-${digitos.slice(5)}` : digitos;
        etapa1SemCobertura.hidden = true;
    });

    async function verificarEndereco() {
        const cep = etapa1Cep.value.replace(/\D/g, "");
        const numero = etapa1Numero.value.trim();

        if (cep.length !== 8) {
            mostrarStatusEtapa1("Digite um CEP válido (8 números).", "erro");
            return;
        }
        if (numero === "") {
            mostrarStatusEtapa1("Digite o número da casa ou prédio.", "erro");
            return;
        }

        btnEtapa1Continuar.disabled = true;
        btnEtapa1Continuar.textContent = "Verificando...";
        etapa1SemCobertura.hidden = true;
        mostrarStatusEtapa1("Verificando cobertura...", "ok");

        try {
            const response = await fetch("/api/viabilidade/consultar.php", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ cep, numero }),
            });
            const data = await response.json();

            if (data.sucesso && data.atende) {
                mostrarStatusEtapa1(`✓ ${data.endereco_encontrado}`, "ok");
                if (data.endereco_partes) {
                    enderecoConfirmado = data.endereco_partes;
                }
                setTimeout(() => irParaEtapa(2), 400);
            } else if (data.sucesso) {
                // sem_cobertura, sem_vaga, endereco_nao_encontrado ou cep_nao_encontrado
                mostrarStatusEtapa1("", "ok");
                etapa1Status.hidden = true;
                etapa1SemCoberturaMsg.textContent = data.mensagem;
                etapa1SemCobertura.hidden = false;
                if (data.endereco_partes) {
                    enderecoConfirmado = data.endereco_partes;
                }
            } else {
                mostrarStatusEtapa1(data.mensagem || "Não consegui verificar agora.", "erro");
            }
        } catch (error) {
            mostrarStatusEtapa1("Não consegui falar com o servidor agora. Tenta de novo em instantes.", "erro");
        } finally {
            btnEtapa1Continuar.disabled = false;
            btnEtapa1Continuar.textContent = "Verificar e continuar";
        }
    }

    btnEtapa1Continuar.addEventListener("click", verificarEndereco);

    const formLeadEtapa1 = document.getElementById("formLeadEtapa1") as HTMLFormElement;
    const etapa1LeadConfirmacao = document.getElementById("etapa1LeadConfirmacao") as HTMLParagraphElement;
    formLeadEtapa1.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const nome = (formLeadEtapa1.querySelector('[name="nome"]') as HTMLInputElement).value.trim();
        const contato = (formLeadEtapa1.querySelector('[name="contato"]') as HTMLInputElement).value.trim();
        const btnLead = formLeadEtapa1.querySelector("button") as HTMLButtonElement;
        btnLead.disabled = true;
        btnLead.textContent = "Enviando...";
        try {
            const resp = await fetch("/api/viabilidade/lead.php", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    nome,
                    contato,
                    endereco: `CEP ${etapa1Cep.value}, nº ${etapa1Numero.value.trim()}`,
                    motivo: "sem_cobertura",
                }),
            });
            const data = await resp.json();
            if (data.sucesso) {
                formLeadEtapa1.hidden = true;
                etapa1LeadConfirmacao.hidden = false;
            } else {
                btnLead.disabled = false;
                btnLead.textContent = "Quero ser avisado";
            }
        } catch (error) {
            btnLead.disabled = false;
            btnLead.textContent = "Quero ser avisado";
        }
    });

    // Chegou com ?cep=&numero= (ex: vindo da busca da home) — pré-preenche e
    // já confere de novo, nunca confia cegamente no que veio na URL.
    const paramsUrl = new URLSearchParams(window.location.search);
    const cepUrl = paramsUrl.get("cep");
    const numeroUrl = paramsUrl.get("numero");
    if (cepUrl) {
        const digitos = cepUrl.replace(/\D/g, "").slice(0, 8);
        etapa1Cep.value = digitos.length > 5 ? `${digitos.slice(0, 5)}-${digitos.slice(5)}` : digitos;
    }
    if (numeroUrl) {
        etapa1Numero.value = numeroUrl;
    }
    if (cepUrl && numeroUrl) {
        verificarEndereco();
    }

    // ---------- ETAPA 2: escolha do plano ----------
    // Os cards (com adicionais e cálculo de preço) são renderizados pelo
    // próprio CardPlano.astro no HTML da página — aqui só escuta o evento
    // que ele dispara quando a pessoa clica em "Escolher este plano".
    window.addEventListener("zamtech:plano-selecionado", ((ev: CustomEvent) => {
        const detalhe = ev.detail as PlanoSelecionado;
        planoEscolhido = detalhe;
        const resumo = document.getElementById("resumoPlanoEscolhido") as HTMLParagraphElement;
        const precoTexto = `R$ ${detalhe.precoFinal.toFixed(2).replace(".", ",")}/mês`;
        const adicionaisTexto = detalhe.adicionais.length > 0 ? ` + ${detalhe.adicionais.join(", ")}` : "";
        resumo.textContent = `Plano escolhido: ${detalhe.nome} (${detalhe.velocidade}) — ${precoTexto}${adicionaisTexto}`;
        irParaEtapa(3);
    }) as EventListener);

    // ---------- ETAPA 2: filtro de plano (só residencial — o toggle
    // Residencial/Empresarial que existia aqui foi removido por deixar a
    // etapa poluída; planos empresariais continuam em /planos-empresariais) ----------
    const planosGridCombos = document.getElementById("planosGridCombos") as HTMLDivElement;
    const planosGridEntrada = document.getElementById("planosGridEntrada") as HTMLDivElement;
    const btnPlanosCombos = document.getElementById("btnPlanosCombos") as HTMLButtonElement;
    const btnPlanosEntrada = document.getElementById("btnPlanosEntrada") as HTMLButtonElement;
    btnPlanosCombos.addEventListener("click", () => {
        btnPlanosCombos.classList.add("is-active");
        btnPlanosEntrada.classList.remove("is-active");
        planosGridCombos.classList.remove("hidden");
        planosGridEntrada.classList.add("hidden");
    });
    btnPlanosEntrada.addEventListener("click", () => {
        btnPlanosEntrada.classList.add("is-active");
        btnPlanosCombos.classList.remove("is-active");
        planosGridEntrada.classList.remove("hidden");
        planosGridCombos.classList.add("hidden");
    });

    document.getElementById("btnEtapa2Voltar")?.addEventListener("click", () => irParaEtapa(1));
    document.getElementById("btnEtapa3Voltar")?.addEventListener("click", () => irParaEtapa(2));

    // ---------- ETAPA 3: dados de contato (mesmos campos do /pre-cadastro) ----------
    function validarCPF(valor: string): boolean {
        const cpf = valor.replace(/[^\d]/g, "");
        if (cpf.length !== 11 || /^(\d)\1{10}$/.test(cpf)) return false;

        let soma = 0;
        for (let i = 0; i < 9; i++) soma += parseInt(cpf[i]) * (10 - i);
        let resto = (soma * 10) % 11;
        if (resto === 10 || resto === 11) resto = 0;
        if (resto !== parseInt(cpf[9])) return false;

        soma = 0;
        for (let i = 0; i < 10; i++) soma += parseInt(cpf[i]) * (11 - i);
        resto = (soma * 10) % 11;
        if (resto === 10 || resto === 11) resto = 0;
        if (resto !== parseInt(cpf[10])) return false;

        return true;
    }

    function mascararCPF(valor: string): string {
        return valor.replace(/[^\d]/g, "").slice(0, 11)
            .replace(/(\d{3})(\d)/, "$1.$2")
            .replace(/(\d{3})(\d)/, "$1.$2")
            .replace(/(\d{3})(\d{1,2})$/, "$1-$2");
    }

    function mascararTelefone(valor: string): string {
        return valor.replace(/[^\d]/g, "").slice(0, 11)
            .replace(/(\d{2})(\d)/, "($1) $2")
            .replace(/(\d{5})(\d{1,4})$/, "$1-$2");
    }

    function forcarMaiusculo(input: HTMLInputElement) {
        const posicaoCursor = input.selectionStart;
        input.value = input.value.toUpperCase();
        if (posicaoCursor !== null) {
            input.setSelectionRange(posicaoCursor, posicaoCursor);
        }
    }

    const nomeInput = document.getElementById("nome") as HTMLInputElement;
    nomeInput.addEventListener("input", () => forcarMaiusculo(nomeInput));

    const cpfInput = document.getElementById("cpf") as HTMLInputElement;
    const cpfErro = document.getElementById("cpfErro") as HTMLElement;
    cpfInput.addEventListener("input", () => {
        cpfInput.value = mascararCPF(cpfInput.value);
        cpfErro.hidden = true;
    });

    const telefone1Input = document.getElementById("telefone1") as HTMLInputElement;
    const telefone2Input = document.getElementById("telefone2") as HTMLInputElement;
    telefone1Input.addEventListener("input", () => { telefone1Input.value = mascararTelefone(telefone1Input.value); });
    telefone2Input.addEventListener("input", () => { telefone2Input.value = mascararTelefone(telefone2Input.value); });

    const diaVencimentoSelect = document.getElementById("diaVencimento") as HTMLSelectElement;
    for (let dia = 1; dia <= 25; dia++) {
        const opcao = document.createElement("option");
        opcao.value = String(dia);
        opcao.textContent = String(dia);
        diaVencimentoSelect.appendChild(opcao);
    }

    const enderecoConfirmadoResumo = document.getElementById("enderecoConfirmadoResumo") as HTMLParagraphElement;

    const form = document.getElementById("formContratar") as HTMLFormElement;
    const mensagemContratar = document.getElementById("mensagemContratar") as HTMLElement;
    const btnEnviarContratar = document.getElementById("btnEnviarContratar") as HTMLButtonElement;

    function mostrarMensagemContratar(html: string, negativo = false) {
        mensagemContratar.innerHTML = html;
        mensagemContratar.classList.remove("hidden");
        mensagemContratar.classList.toggle("negativa", negativo);
    }

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!enderecoConfirmado) {
            mostrarMensagemContratar("<p>Volta na etapa 1 e confirma seu endereço antes de continuar.</p>", true);
            return;
        }
        if (!planoEscolhido) {
            mostrarMensagemContratar("<p>Volta na etapa 2 e escolhe um plano antes de continuar.</p>", true);
            return;
        }

        const cpf = cpfInput.value.trim();
        if (!validarCPF(cpf)) {
            cpfErro.hidden = false;
            cpfInput.focus();
            return;
        }
        cpfErro.hidden = true;

        const dados = {
            tipoPessoa: "F",
            nome: nomeInput.value.trim(),
            cpfCnpj: cpf,
            dataNascimento: (document.getElementById("dataNascimento") as HTMLInputElement).value,
            telefone1: telefone1Input.value.trim(),
            telefone2: telefone2Input.value.trim(),
            estadoCivil: (document.getElementById("estadoCivil") as HTMLSelectElement).value,
            sexo: (document.getElementById("sexo") as HTMLSelectElement).value,
            email: (document.getElementById("email") as HTMLInputElement).value.trim(),
            cep: enderecoConfirmado.cep,
            logradouro: enderecoConfirmado.logradouro,
            numero: enderecoConfirmado.numero,
            complemento: (document.getElementById("complemento") as HTMLInputElement).value.trim(),
            bairro: enderecoConfirmado.bairro,
            cidade: enderecoConfirmado.cidade,
            uf: enderecoConfirmado.uf,
            pontoReferencia: (document.getElementById("pontoReferencia") as HTMLInputElement).value.trim(),
            // Plano é só referência pra Carol — quem decide/fecha de fato é ela
            // na ligação, por isso vai como texto livre, não como plano_id.
            velocidadeDesejada: `${planoEscolhido.nome} (${planoEscolhido.velocidade}, R$ ${planoEscolhido.precoFinal.toFixed(2).replace(".", ",")}/mês${planoEscolhido.adicionais.length > 0 ? ", com " + planoEscolhido.adicionais.join(", ") : ""}) — escolhido em /contratar`,
            diaVencimento: diaVencimentoSelect.value,
            aceite: (document.getElementById("aceite") as HTMLInputElement).checked,
        };

        btnEnviarContratar.disabled = true;
        btnEnviarContratar.textContent = "Enviando seus dados...";
        mensagemContratar.classList.add("hidden");

        try {
            const response = await fetch("/api/pre-cadastro/cadastrar.php", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(dados),
            });
            const data = await response.json();

            if (data.sucesso) {
                const mensagemZap = `Oi! Acabei de fazer meu pré-cadastro no site. Meu nome é ${dados.nome}, CPF ${dados.cpfCnpj}. Escolhi o plano ${planoEscolhido.nome} (${planoEscolhido.velocidade}). Pode conferir e agilizar minha instalação?`;
                const btnWhatsappFinal = document.getElementById("btnWhatsappFinal") as HTMLAnchorElement;
                btnWhatsappFinal.href = `https://wa.me/5527995057736?text=${encodeURIComponent(mensagemZap)}`;
                irParaEtapa(4);
            } else {
                const ehErroDeSistema = data.tipo === "erro";
                let html = `<p>${data.mensagem || "Não consegui enviar seu cadastro agora."}</p>`;
                if (ehErroDeSistema) {
                    html += `<a href="https://wa.me/5527995057736" target="_blank" rel="noopener noreferrer" class="btn btn-outlined-light">Falar no WhatsApp</a>`;
                }
                mostrarMensagemContratar(html, true);
            }
        } catch (error) {
            mostrarMensagemContratar(`
                <p>Não consegui falar com o servidor agora. Tenta de novo em instantes ou fala com a gente:</p>
                <a href="https://wa.me/5527995057736" target="_blank" rel="noopener noreferrer" class="btn btn-outlined-light">Falar no WhatsApp</a>
            `, true);
        } finally {
            btnEnviarContratar.disabled = false;
            btnEnviarContratar.textContent = "Enviar pré-cadastro";
        }
    });

    // Atualiza o resumo do endereço na etapa 3 assim que ele é confirmado.
    const observadorEndereco = setInterval(() => {
        if (enderecoConfirmado) {
            enderecoConfirmadoResumo.textContent = `${enderecoConfirmado.logradouro}, ${enderecoConfirmado.numero} - ${enderecoConfirmado.bairro}, ${enderecoConfirmado.cidade}/${enderecoConfirmado.uf} (CEP ${enderecoConfirmado.cep})`;
            clearInterval(observadorEndereco);
        }
    }, 300);
</script>

