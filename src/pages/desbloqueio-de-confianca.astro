---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Desbloqueio de Confiança | Zamtech - Fibra Óptica">
  
  <main class="desbloqueio-page">
    <div class="desbloqueio-container">
      <div class="desbloqueio-card">
        <div class="card-header-icon">
          <img src="/assets/icons/others-icons/desbloquear-servico-white.svg" alt="Ícone Desbloqueio de Confiança" />
        </div>
        <h1>Desbloqueio de Confiança</h1>
        <p class="subtitle">Informe seus dados abaixo para restabelecer temporariamente sua conexão de fibra óptica de forma rápida e segura.</p>
        
        <form id="formDesbloqueio" class="desbloqueio-form">
          <div class="input-group">
            <label for="cpf">CPF / CNPJ do Titular</label>
            <input 
              type="text" 
              id="cpf" 
              name="cpf" 
              required 
              placeholder="000.000.000-00" 
              autocomplete="off"
            />
          </div>

          <div class="input-group">
            <label for="contrato">ID do Contrato</label>
            <input 
              type="number" 
              id="contrato" 
              name="contrato" 
              required 
              placeholder="Ex: 42" 
              autocomplete="off"
            />
          </div>

          <button type="submit" id="btnSubmit" class="btn-zamtech">
            <span>Solicitar Desbloqueio</span>
          </button>
        </form>

        <div id="mensagemRetorno" class="mensagem-retorno hidden"></div>

        <div class="ajuda-suporte">
          <p>Dificuldades para desbloquear? Fale com nosso <a href="https://wa.me/5527995057736?text=Ol%C3%A1,%20gostaria%20de%20falar%20com%20o%20SUPORTE%20T%C3%89CNICO" target="_blank">suporte técnico</a></p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .desbloqueio-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem 6rem;
    background: var(--bg-color, #0b0f19);
    color: var(--text-color, #ffffff);
  }

  .desbloqueio-container {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }

  .desbloqueio-card {
    background: rgba(18, 24, 38, 0.95);
    border: 1px solid rgba(0, 212, 255, 0.2);
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
  }

  .card-header-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 120, 255, 0.2));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(0, 212, 255, 0.3);
  }

  .card-header-icon img {
    width: 32px;
    height: 32px;
  }

  .desbloqueio-card h1 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #ffffff;
    letter-spacing: -0.5px;
  }

  .subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .desbloqueio-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .input-group input {
    width: 100%;
    padding: 0.875rem 1rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid #334155;
    border-radius: 8px;
    color: #ffffff;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .input-group input:focus {
    outline: none;
    border-color: #00d4ff;
    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.15);
  }

  .btn-zamtech {
    margin-top: 0.5rem;
    width: 100%;
    padding: 1rem;
    background: linear-gradient(135deg, #00d4ff 0%, #0077ff 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 15px rgba(0, 119, 255, 0.3);
  }

  .btn-zamtech:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 119, 255, 0.5);
  }

  .btn-zamtech:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .mensagem-retorno {
    margin-top: 1.5rem;
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.4;
    text-align: center;
  }

  .mensagem-retorno.hidden {
    display: none;
  }

  .mensagem-retorno.sucesso {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid #10b981;
    color: #34d399;
  }

  .mensagem-retorno.erro {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid #ef4444;
    color: #f87171;
  }

  .ajuda-suporte {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.85rem;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1.5rem;
  }

  .ajuda-suporte a {
    color: #00d4ff;
    text-decoration: none;
    font-weight: 600;
  }

  .ajuda-suporte a:hover {
    text-decoration: underline;
  }
</style>

<script>
  const form = document.getElementById('formDesbloqueio') as HTMLFormElement;
  const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement;
  const mensagemRetorno = document.getElementById('mensagemRetorno') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnSubmit.setAttribute('disabled', 'true');
      const btnText = btnSubmit.querySelector('span');
      if (btnText) btnText.textContent = 'Processando...';

      const cpf = (document.getElementById('cpf') as HTMLInputElement).value;
      const contrato = (document.getElementById('contrato') as HTMLInputElement).value;

      try {
        const response = await fetch('https://suazamtech.com.br/api/desbloqueio-de-confianca.php', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: `cpf=${encodeURIComponent(cpf)}&contrato=${encodeURIComponent(contrato)}`
        });

        const resultado = await response.json();

        mensagemRetorno.classList.remove('hidden');
        if (resultado.sucesso) {
          mensagemRetorno.className = 'mensagem-retorno sucesso';
          mensagemRetorno.textContent = resultado.mensagem;
        } else {
          mensagemRetorno.className = 'mensagem-retorno erro';
          mensagemRetorno.textContent = resultado.mensagem;
        }
      } catch (error) {
        mensagemRetorno.classList.remove('hidden');
        mensagemRetorno.className = 'mensagem-retorno erro';
        mensagemRetorno.textContent = 'Erro de comunicação com o servidor. Tente novamente mais tarde.';
      } finally {
        btnSubmit.removeAttribute('disabled');
        if (btnText) btnText.textContent = 'Solicitar Desbloqueio';
      }
    });
  }
</script>