---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="404 - Página Não Encontrada | Zamtech Fibra Óptica">
    <section class="error-section">
        <div class="container error-container">
            <div class="error-code-wrapper">
                <span class="error-code">404</span>
            </div>

            <!-- Informações Principais -->
            <div class="error-header">
                <span class="status-badge">
                    <span class="status-dot"></span>
                    Sinal Interrompido
                </span>
                <h1>Ops! Página não encontrada</h1>
                <p>
                    O endereço que você tentou acessar não existe, foi alterado ou está temporariamente indisponível.
                </p>
            </div>

            <!-- Botão Principal de Retorno -->
            <div class="error-action-main">
                <a href="/" class="btn btn-primary btn-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    Voltar para a Página Inicial
                </a>
            </div>

            <!-- Seção de Links Úteis -->
            <div class="useful-links-section">
                <h2>Para onde você gostaria de navegar?</h2>
                <div class="links-grid">
                    <a href="/planos-residenciais" class="link-card">
                        <div class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                        </div>
                        <div class="card-info">
                            <h3>Planos Residenciais</h3>
                            <p>Ultravelocidade, Wi-Fi 6 e estabilidade para sua casa.</p>
                        </div>
                        <span class="card-arrow">&rarr;</span>
                    </a>

                    <a href="/planos-empresariais" class="link-card">
                        <div class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect>
                                <path d="M9 22v-4h6v4"></path>
                                <path d="M8 6h.01"></path>
                                <path d="M16 6h.01"></path>
                                <path d="M12 6h.01"></path>
                                <path d="M12 10h.01"></path>
                                <path d="M12 14h.01"></path>
                                <path d="M16 10h.01"></path>
                                <path d="M16 14h.01"></path>
                                <path d="M8 10h.01"></path>
                                <path d="M8 14h.01"></path>
                            </svg>
                        </div>
                        <div class="card-info">
                            <h3>Planos Empresariais</h3>
                            <p>Soluções em conectividade, PABX e voz para o seu negócio.</p>
                        </div>
                        <span class="card-arrow">&rarr;</span>
                    </a>

                    <a href="/ajuda" class="link-card">
                        <div class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                <line x1="12" x2="12.01" y1="17" y2="17"></line>
                            </svg>
                        </div>
                        <div class="card-info">
                            <h3>Central de Ajuda</h3>
                            <p>Tire suas dúvidas, veja tutoriais e suporte técnico.</p>
                        </div>
                        <span class="card-arrow">&rarr;</span>
                    </a>

                    <a href="/contato" class="link-card">
                        <div class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </div>
                        <div class="card-info">
                            <h3>Fale Conosco</h3>
                            <p>Atendimento direto e canais oficiais de comunicação.</p>
                        </div>
                        <span class="card-arrow">&rarr;</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .error-section {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-48) 0;
        background: var(--color-gray-light);
        color: var(--color-gray-dark);
        position: relative;
        overflow: hidden;
    }

    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 900px;
        z-index: 2;
    }

    /* 404 Efeito Glowing */
    .error-code-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: var(--space-16);
    }

    .error-code {
        font-family: var(--font-display);
        font-size: clamp(6rem, 15vw, 11rem);
        font-weight: 900;
        line-height: 0.9;
        letter-spacing: -2px;
        position: relative;
        z-index: 2;
        background: var(--gradient-brand);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 12px 28px rgba(3, 37, 208, 0.25));
    }

    /* Header text */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-8);
        padding: var(--space-4) var(--space-16);
        background-color: var(--color-white);
        border: 1px solid rgba(3, 37, 208, 0.15);
        box-shadow: var(--elevation-1);
        border-radius: var(--radius-full);
        font-size: var(--fs-caption);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--color-gray-dark);
        margin-bottom: var(--space-16);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        background-color: var(--color-secondary);
        border-radius: 50%;
        animation: pulse-dot 1.6s ease-in-out infinite;
    }

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.35; }
    }

    .error-header h1 {
        font-size: var(--fs-h1);
        color: var(--color-gray-medium);
        margin-bottom: var(--space-12);
    }

    .error-header p {
        font-size: var(--fs-body);
        color: var(--color-gray-medium);
        max-width: 550px;
        margin: 0 auto var(--space-32);
        line-height: 1.6;
    }

    /* Botão Principal */
    .btn-lg {
        min-height: 52px;
        padding: 0 var(--space-32);
        font-size: var(--fs-body);
        gap: var(--space-8);
    }

    /* Links Úteis Grid */
    .useful-links-section {
        width: 100%;
        margin-top: var(--space-64);
        padding-top: var(--space-32);
        border-top: 1px solid var(--color-gray-low);
    }

    .useful-links-section h2 {
        font-size: var(--fs-h4);
        color: var(--color-gray-medium);
        margin-bottom: var(--space-24);
        font-weight: 600;
    }

    .links-grid {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: var(--space-16);
        text-align: left;
    }

    @media (min-width: 640px) {
        .links-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .link-card {
        display: flex;
        align-items: center;
        gap: var(--space-16);
        padding: var(--space-20, 1.25rem);
        background-color: var(--color-gray-light);
        border: 1px solid var(--color-gray-low);
        border-radius: var(--radius-lg);
        transition: var(--transition-default);
        text-decoration: none;
        color: var(--color-gray-dark);
    }

    .link-card:hover {
        color: var(--color-white);
        background: var(--gradient-brand);
        border-color: var(--color-primary);
        transform: translateY(-3px);
        box-shadow: var(--elevation-2);
    }

    .card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        background-color: rgba(7, 86, 255, 0.15);
        color: var(--color-secondary);
        flex-shrink: 0;
    }

    .card-info {
        flex: 1;
    }


    .card-info h3 {
        font-size: var(--fs-h5);
        margin-bottom: 2px;
    }

    .card-info p {
        font-size: var(--fs-caption);
        line-height: 1.4;
    }

    .card-arrow {
        color: var(--color-gray-dark);
        font-size: 1.2rem;
        transition: var(--transition-default);
    }

    .link-card:hover .card-arrow {
        color: var(--color-white);
        transform: translateX(4px);
    }
</style>