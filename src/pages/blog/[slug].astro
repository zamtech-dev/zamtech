---
import Layout from '../../layouts/Layout.astro';
import {
    buscarTodosOsArtigos,
    buscarArtigoPorSlug,
    buscarComentarios,
    tempoDeLeitura,
    formatarDataLeitura,
    WORDPRESS_API_URL,
} from '../../lib/wordpress';

export async function getStaticPaths() {
    const artigos = await buscarTodosOsArtigos();
    return artigos.map((artigo) => ({ params: { slug: artigo.slug } }));
}

const { slug } = Astro.params;
const artigo = await buscarArtigoPorSlug(slug!);

if (!artigo) {
    return Astro.redirect('/404');
}

const comentarios = await buscarComentarios(artigo.id);

const urlCanonica = `https://zamtech.com.br/blog/${artigo.slug}`;
const imagemSeo = artigo.imagemCapa || 'https://zamtech.com.br/assets/icons/logo-zamtech.svg';
const tempoLeitura = tempoDeLeitura(artigo.conteudoHtml);
const categoriaPrincipal = artigo.categorias[0]?.nome ?? '';

const heroStyle = artigo.imagemCapa
    ? `background-image: linear-gradient(rgba(0, 15, 118, 0.85), rgba(3, 37, 208, 0.85)), url("${artigo.imagemCapa}");`
    : `background-image: linear-gradient(rgba(0, 15, 118, 0.92), rgba(3, 37, 208, 0.92));`;

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: artigo.titulo,
    description: artigo.metaDescricao,
    datePublished: artigo.dataPublicacao,
    dateModified: artigo.dataModificacao,
    mainEntityOfPage: { '@type': 'WebPage', '@id': urlCanonica },
    publisher: {
        '@type': 'Organization',
        name: 'Zamtech',
        logo: { '@type': 'ImageObject', url: 'https://zamtech.com.br/assets/icons/logo-zamtech.svg' },
    },
    author: { '@type': 'Person', name: artigo.autorNome },
    ...(artigo.imagemCapa ? { image: [imagemSeo] } : {}),
};

const usaInstagram = artigo.conteudoHtml.includes('instagram.com');
const usaTwitter = artigo.conteudoHtml.includes('twitter.com') || artigo.conteudoHtml.includes('x.com');
---

<Layout
    title={`${artigo.metaTitulo} — Blog Zamtech`}
    description={artigo.metaDescricao}
    canonical={urlCanonica}
    ogImage={imagemSeo}
    ogType="article"
>
    <link rel="stylesheet" href="/blog/assets/blog.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <section class="artigo-hero" style={heroStyle}>
        <div class="container artigo-hero-content">
            {categoriaPrincipal && <span class="artigo-hero-badge">{categoriaPrincipal}</span>}
            <h1>{artigo.titulo}</h1>
        </div>
    </section>

    <main class="artigo-pagina section container">
        <article>
            <div class="artigo-info-bar">
                <div class="artigo-autor">
                    {artigo.autorAvatar && <img src={artigo.autorAvatar} alt="" class="artigo-autor-avatar" />}
                    <div>
                        <span class="artigo-autor-nome">Por {artigo.autorNome}</span>
                        <span class="artigo-meta">
                            {formatarDataLeitura(artigo.dataPublicacao)} &middot; {tempoLeitura} min de leitura
                        </span>
                    </div>
                </div>

                <div class="artigo-acoes">
                    <button type="button" id="btn-curtir" class="btn-curtir" data-post-id={artigo.id}>
                        <span class="btn-curtir-coracao">♥</span>
                        <span id="curtir-contagem">{artigo.curtidas}</span>
                    </button>

                    <div class="artigo-compartilhar">
                        <button type="button" id="btn-compartilhar" class="btn-compartilhar" aria-label="Compartilhar">
                            ↗ Compartilhar
                        </button>
                        <div class="compartilhar-opcoes" id="compartilhar-opcoes" hidden>
                            <a id="link-whatsapp" href="#" target="_blank" rel="noopener noreferrer">
                                <img src="/assets/icons/social/whatsapp.svg" alt="" />
                                WhatsApp
                            </a>
                            <a id="link-facebook" href="#" target="_blank" rel="noopener noreferrer">
                                <img src="/assets/icons/social/facebook.svg" alt="" />
                                Facebook
                            </a>
                            <button type="button" id="btn-copiar-link">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                                </svg>
                                <span id="btn-copiar-link-texto">Copiar link</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="artigo-corpo" set:html={artigo.conteudoHtml} />
        </article>

        <section class="comentarios" id="comentarios">
            <h2>Comentários {comentarios.length > 0 && `(${comentarios.length})`}</h2>

            <div class="comentarios-lista" id="comentarios-lista">
                {comentarios.length === 0 ? (
                    <p class="comentarios-vazio">Seja o primeiro a comentar.</p>
                ) : (
                    comentarios.map((c) => (
                        <div class="comentario">
                            {c.autorAvatar && <img src={c.autorAvatar} alt="" class="comentario-avatar" />}
                            <div class="comentario-corpo">
                                <span class="comentario-autor">{c.autorNome}</span>
                                <div class="comentario-texto" set:html={c.conteudoHtml} />
                            </div>
                        </div>
                    ))
                )}
            </div>

            <div id="comentario-google-btn" class="comentario-google-btn"></div>

            <form id="form-comentario" class="form-comentario">
                <input type="hidden" id="comentario-post-id" value={artigo.id} />
                <div class="form-comentario-linha">
                    <input type="text" id="comentario-nome" placeholder="Seu nome" required />
                    <input type="email" id="comentario-email" placeholder="Seu e-mail (não aparece pra ninguém)" required />
                </div>
                <textarea id="comentario-texto" placeholder="Escreva seu comentário..." rows="4" required></textarea>
                <button type="submit" class="btn btn-primary">Comentar</button>
                <p id="comentario-status" class="comentario-status" hidden></p>
            </form>
        </section>

        <div class="artigo-voltar">
            <a href="/blog/" class="btn-voltar-blog">&larr; Ver todos os artigos</a>
        </div>
    </main>

    {usaInstagram && <script async src="https://www.instagram.com/embed.js"></script>}
    {usaTwitter && <script async src="https://platform.twitter.com/widgets.js"></script>}

    <script define:vars={{ WORDPRESS_API_URL, urlCanonica, tituloArtigo: artigo.titulo }}>
        const CHAVE_CURTIDO = (id) => `zamtech-curtiu-${id}`;
        const btnCurtir = document.getElementById('btn-curtir');
        if (btnCurtir) {
            const postId = btnCurtir.dataset.postId;
            const contagemEl = document.getElementById('curtir-contagem');

            if (localStorage.getItem(CHAVE_CURTIDO(postId)) === '1') {
                btnCurtir.classList.add('curtido');
                btnCurtir.disabled = true;
            }

            btnCurtir.addEventListener('click', async () => {
                if (localStorage.getItem(CHAVE_CURTIDO(postId)) === '1') return;
                btnCurtir.disabled = true;
                try {
                    const resp = await fetch(`${WORDPRESS_API_URL.replace('/wp/v2', '')}/zamtech/v1/curtir/${postId}`, {
                        method: 'POST',
                    });
                    if (resp.ok) {
                        const dados = await resp.json();
                        if (contagemEl) contagemEl.textContent = String(dados.curtidas);
                        btnCurtir.classList.add('curtido');
                        localStorage.setItem(CHAVE_CURTIDO(postId), '1');
                    } else {
                        btnCurtir.disabled = false;
                    }
                } catch {
                    btnCurtir.disabled = false;
                }
            });
        }

        const btnCompartilhar = document.getElementById('btn-compartilhar');
        const opcoesCompartilhar = document.getElementById('compartilhar-opcoes');
        const linkWhats = document.getElementById('link-whatsapp');
        const linkFace = document.getElementById('link-facebook');
        const btnCopiar = document.getElementById('btn-copiar-link');

        if (linkWhats) linkWhats.href = `https://wa.me/?text=${encodeURIComponent(tituloArtigo + ' ' + urlCanonica)}`;
        if (linkFace) linkFace.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlCanonica)}`;

        if (btnCompartilhar) {
            btnCompartilhar.addEventListener('click', async () => {
                if (navigator.share) {
                    try {
                        await navigator.share({ title: tituloArtigo, url: urlCanonica });
                        return;
                    } catch {
                    }
                }
                if (opcoesCompartilhar) opcoesCompartilhar.hidden = !opcoesCompartilhar.hidden;
            });
        }

        if (btnCopiar) {
            const textoCopiar = document.getElementById('btn-copiar-link-texto');
            btnCopiar.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(urlCanonica);
                    if (textoCopiar) textoCopiar.textContent = 'Link copiado!';
                    setTimeout(() => {
                        if (textoCopiar) textoCopiar.textContent = 'Copiar link';
                    }, 2000);
                } catch {
                }
            });
        }

        const form = document.getElementById('form-comentario');
        const status = document.getElementById('comentario-status');
        const inputNome = document.getElementById('comentario-nome');
        const inputEmail = document.getElementById('comentario-email');

        if (form) {
            form.addEventListener('submit', async (ev) => {
                ev.preventDefault();
                const botao = form.querySelector('button[type="submit"]');
                botao.disabled = true;

                try {
                    const resp = await fetch(`${WORDPRESS_API_URL}/comments`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            post: Number(document.getElementById('comentario-post-id').value),
                            author_name: inputNome.value,
                            author_email: inputEmail.value,
                            content: document.getElementById('comentario-texto').value,
                        }),
                    });

                    if (status) {
                        status.hidden = false;
                        if (resp.ok) {
                            status.textContent = 'Comentário enviado! Ele aparece aqui assim que for aprovado.';
                            status.className = 'comentario-status comentario-status--ok';
                            form.reset();
                        } else {
                            status.textContent = 'Não consegui enviar seu comentário agora. Tenta de novo em instantes.';
                            status.className = 'comentario-status comentario-status--erro';
                        }
                    }
                } catch {
                    if (status) {
                        status.hidden = false;
                        status.textContent = 'Não consegui falar com o servidor agora.';
                        status.className = 'comentario-status comentario-status--erro';
                    }
                } finally {
                    botao.disabled = false;
                }
            });
        }

        const GOOGLE_CLIENT_ID = 'COLOQUE_SEU_GOOGLE_CLIENT_ID_AQUI.apps.googleusercontent.com';

        function decodificarJwt(token) {
            try {
                const payload = token.split('.')[1];
                return JSON.parse(atob(payload.replace(/-/g, '+').replace(/_/g, '/')));
            } catch {
                return null;
            }
        }

        if (!GOOGLE_CLIENT_ID.startsWith('COLOQUE_')) {
            const scriptGoogle = document.createElement('script');
            scriptGoogle.src = 'https://accounts.google.com/gsi/client';
            scriptGoogle.async = true;
            scriptGoogle.onload = () => {
                try {
                    window.google.accounts.id.initialize({
                        client_id: GOOGLE_CLIENT_ID,
                        callback: (resposta) => {
                            const dados = decodificarJwt(resposta.credential);
                            if (dados) {
                                inputNome.value = dados.name || '';
                                inputEmail.value = dados.email || '';
                            }
                        },
                    });
                    window.google.accounts.id.renderButton(
                        document.getElementById('comentario-google-btn'),
                        { theme: 'outline', size: 'medium', text: 'continue_with' }
                    );
                } catch {
                }
            };
            document.head.appendChild(scriptGoogle);
        }
    </script>
</Layout>
