---
import Layout from '../../../layouts/Layout.astro';
import CardArtigo from '../../../components/blog/CardArtigo.astro';
import SidebarBlog from '../../../components/blog/SidebarBlog.astro';
import BuscaArtigos from '../../../components/blog/BuscaArtigos.astro';
import { buscarTodosOsArtigos, buscarCategorias, POR_PAGINA } from '../../../lib/wordpress';

export async function getStaticPaths() {
    const todosOsArtigos = await buscarTodosOsArtigos();
    const totalPaginas = Math.max(1, Math.ceil(todosOsArtigos.length / POR_PAGINA));

    return Array.from({ length: Math.max(0, totalPaginas - 1) }).map((_, i) => ({
        params: { pagina: String(i + 2) },
    }));
}

const { pagina } = Astro.params;
const numeroPagina = Number(pagina);

const todosOsArtigos = await buscarTodosOsArtigos();
const categorias = await buscarCategorias();

const inicio = (numeroPagina - 1) * POR_PAGINA;
const artigos = todosOsArtigos.slice(inicio, inicio + POR_PAGINA);
const recentes = todosOsArtigos.slice(0, 3);
const totalPaginas = Math.max(1, Math.ceil(todosOsArtigos.length / POR_PAGINA));
---

<Layout
    title={`Blog Zamtech — página ${numeroPagina}`}
    description="Fique por dentro de dicas de internet, novidades da Zamtech e conteúdos sobre fibra óptica, Wi-Fi e conectividade."
>
    <link rel="stylesheet" href="/blog/assets/blog.css" />

    <main class="blog-listagem section container">
        <h1 class="blog-titulo-pagina">Blog Zamtech</h1>
        <p class="blog-subtitulo-pagina">Dicas, novidades e conteúdo sobre internet fibra óptica</p>

        <BuscaArtigos />

        <div class="blog-layout">
            <SidebarBlog categorias={categorias} recentes={recentes} />

            <div class="blog-conteudo">
                <div class="blog-grid">
                    {artigos.map((artigo) => <CardArtigo artigo={artigo} />)}
                </div>

                <nav class="blog-paginacao">
                    {Array.from({ length: totalPaginas }).map((_, i) => {
                        const n = i + 1;
                        const href = n === 1 ? '/blog/' : `/blog/pagina/${n}/`;
                        return <a href={href} class={n === numeroPagina ? 'ativa' : ''}>{n}</a>;
                    })}
                </nav>
            </div>
        </div>
    </main>
</Layout>
