---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Zamtech - Fibra Óptica">
    <main>
        <!-- HERO SECTION -->
        <section class="hero-section">
            <div class="container">
                <h1 class="hero-title">Internet rápida, segura e acessível</h1>

                <div class="plans-showcase">
                    <!-- Card 500 Mega -->
                    <article class="plan-card">
                        <div class="plan-header">
                            <span class="plan-brand">ZAMTECH</span>
                            <h2 class="plan-title">500MEGA</h2>
                        </div>
                        <div class="plan-price">
                            <span class="price-currency">R$</span>
                            <span class="price-integer">89</span>
                            <div class="price-fraction-period">
                                <span class="price-fraction">,90</span>
                                <span class="price-period">/mês</span>
                            </div>
                        </div>
                        <p class="plan-description">
                            Internet estável para todos os momentos
                        </p>
                        <a href="https://wa.me/5527995057736?text=Ol%C3%A1%21%20Gostaria%20de%20adquirir%20o%20plano%20ZAMTECH%20500MEGA%20por%20R%24%2089%2C90%2Fm%C3%AAs." target="_blank" class="btn btn-primary btn-full"
                            >Adquirir Plano</a>
                    </article>

                    <!-- Card Destaque (800 Mega Mesh) -->
                    <article class="plan-card plan-card--featured">
                        <div class="plan-badge">RECOMENDADO</div>
                        <div class="plan-header">
                            <span class="plan-brand">ZAMTECH</span>
                            <h2 class="plan-title">
                                800MEGA <span class="title-accent">+MESH</span>
                            </h2>
                        </div>
                        <div class="plan-price">
                            <span class="price-currency">R$</span>
                            <span class="price-integer">129</span>
                            <div class="price-fraction-period">
                                <span class="price-fraction">,90</span>
                                <span class="price-period">/mês</span>
                            </div>
                        </div>
                        <p class="plan-description">
                            Wi-Fi potente em todos os ambientes, sem pontos
                            fracos
                        </p>
                        <a href="https://wa.me/5527995057736?text=Ol%C3%A1%21%20Gostaria%20de%20adquirir%20o%20Combo%20Mesh%3A%20ZAMTECH%20800MEGA%20%2B%20MESH%20por%20R%24%20129%2C90%2Fm%C3%AAs" target="_blank" class="btn btn-primary btn-full"
                            >Adquirir Combo Mesh</a>
                    </article>

                    <!-- Card 800 Mega -->
                    <article class="plan-card">
                        <div class="plan-header">
                            <span class="plan-brand">ZAMTECH</span>
                            <h2 class="plan-title">800MEGA</h2>
                        </div>
                        <div class="plan-price">
                            <span class="price-currency">R$</span>
                            <span class="price-integer">99</span>
                            <div class="price-fraction-period">
                                <span class="price-fraction">,90</span>
                                <span class="price-period">/mês</span>
                            </div>
                        </div>
                        <p class="plan-description">
                            Mais velocidade para uma casa conectada
                        </p>
                        <a href="https://wa.me/5527995057736?text=Ol%C3%A1%21%20Gostaria%20de%20adquirir%20o%20plano%20ZAMTECH%20800MEGA%20por%20R%24%2099%2C90%2Fm%C3%AAs." target="_blank" class="btn btn-primary btn-full"
                            >Adquirir Plano</a>
                    </article>
                </div>
            </div>
        </section>

        <!-- CONSULTA DE VIABILIDADE -->
        <!-- Busca estilo Google: a pessoa digita o endereço e a gente checa a
             CTO (caixinha de fibra) mais próxima cadastrada no SGP, com
             latitude/longitude e portas livres. É uma estimativa por
             distância, nunca uma confirmação 100% técnica — por isso o texto
             sempre fala "provavelmente" e sempre existe um caminho pro
             WhatsApp/comercial confirmar de verdade. -->
        <section class="section viabilidade-section">
            <div class="container-narrow">
                <h2 class="viabilidade-title">Já chegamos na sua rua?</h2>
                <p class="viabilidade-subtitle">
                    Digite seu endereço e veja se a Zamtech já atende sua região
                </p>

                <form id="viabilidade-form" class="viabilidade-search" autocomplete="off">
                    <input
                        type="text"
                        id="viabilidade-cep"
                        name="cep"
                        class="viabilidade-search-input viabilidade-search-input--cep"
                        placeholder="Seu CEP"
                        inputmode="numeric"
                        maxlength="9"
                        required
                    />
                    <input
                        type="text"
                        id="viabilidade-numero"
                        name="numero"
                        class="viabilidade-search-input viabilidade-search-input--numero"
                        placeholder="Número"
                        maxlength="7"
                        required
                    />
                    <button type="submit" class="viabilidade-search-btn">
                        <span class="viabilidade-search-btn-texto">Verificar</span>
                    </button>
                </form>

                <p id="viabilidade-cep-status" class="viabilidade-cep-status" hidden></p>

                <div id="viabilidade-resultado" class="viabilidade-resultado" hidden></div>
            </div>
        </section>

        <!-- FEATURES BÁSICAS -->
        <section class="section section-tint features-section">
            <div class="container">
                <div class="grid-3-cols">
                    <article class="feature-card" data-reveal>
                        <div class="feature-icon-wrapper">
                            <img
                                src="/assets/icons/ultra-velocidade.svg"
                                alt="Ultra Velocidade"
                                class="feature-icon"
                            />
                        </div>
                        <h3 class="feature-title">Ultra Velocidade</h3>
                        <p class="feature-description">
                            Faça downloads pesados, envie arquivos grandes e
                            assista a vídeos em 4K ou 8K ao mesmo tempo, sem
                            lentidão.
                        </p>
                    </article>

                    <article class="feature-card feature-card--dark" data-reveal data-reveal-atraso="1">
                        <div class="feature-icon-wrapper">
                            <img
                                src="/assets/icons/estabilidade.svg"
                                alt="Estabilidade Garantida"
                                class="feature-icon"
                            />
                        </div>
                        <h3 class="feature-title">Estabilidade Garantida</h3>
                        <p class="feature-description">
                            Conexão 100% em fibra óptica de ponta a ponta,
                            garantindo que a sua internet não caia quando você
                            mais precisa.
                        </p>
                    </article>

                    <article class="feature-card" data-reveal data-reveal-atraso="2">
                        <div class="feature-icon-wrapper">
                            <img
                                src="/assets/icons/suporte.svg"
                                alt="Suporte Eficiente"
                                class="feature-icon"
                            />
                        </div>
                        <h3 class="feature-title">Suporte Eficiente</h3>
                        <p class="feature-description">
                            Equipe técnica qualificada e pronta para atender e
                            resolver qualquer solicitação com o máximo de
                            agilidade.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- POR QUE ESCOLHER A ZAMTECH -->
        <section class="section why-choose-section">
            <div class="container">
                <header class="section-header">
                    <h2 class="section-title">Por que escolher a Zamtech?</h2>
                    <p class="section-subtitle">
                        A melhor experiência em conexão para você trabalhar,
                        estudar e se divertir.
                    </p>
                </header>

                <div class="grid-3-cols">
                    <article class="benefit-card" data-reveal>
                        <img
                            src="/assets/icons/fibra-icon.svg"
                            alt=""
                            class="benefit-icon"
                        />
                        <h4>Internet 100% Fibra Óptica</h4>
                        <p>Levamos a fibra óptica até a sua casa por meio da nossa rede FTTH, proporcionando uma conexão estável, rápida e com excelente desempenho para o seu dia a dia.</p>
                    </article>

                    <article class="benefit-card" data-reveal data-reveal-atraso="2">
                        <img
                            src="/assets/icons/tech-icon.svg"
                            alt=""
                            class="benefit-icon"
                        />
                        <h4>Tecnologia de ponta</h4>
                        <p>
                            Navegue, jogue e assista a vídeos em 4K sem
                            travamentos com a estabilidade que só a Zamtech
                            oferece.
                        </p>
                    </article>

                    <article class="benefit-card" data-reveal data-reveal-atraso="3">
                        <img
                            src="/assets/icons/suporte-24h.svg"
                            alt=""
                            class="benefit-icon"
                        />
                        <h4>Suporte 24h</h4>
                        <p>
                            Atendimento humanizado e rápido sempre que você
                            precisar, garantindo que você nunca fique
                            desconectado.
                        </p>
                    </article>

                    <article class="benefit-card" data-reveal data-reveal-atraso="4">
                        <img
                            src="/assets/icons/suporte_-02.svg"
                            alt=""
                            class="benefit-icon"
                        />
                        <h4>Suporte Humanizado e Rápido</h4>
                        <p>
                            Sem robôs ou respostas automáticas demoradas. Nosso
                            time técnico atende você com agilidade e respeito
                            sempre que precisar.
                        </p>
                    </article>

                    <article class="benefit-card" data-reveal>
                        <img
                            src="/assets/icons/latencia-icon.svg"
                            alt=""
                            class="benefit-icon"
                        />
                        <h4>Latência Mínima (Ping Baixo)</h4>
                        <p>
                            A estabilidade que os gamers e profissionais
                            precisam. Jogue online sem lag e participe de
                            videoconferências em tempo real.
                        </p>
                    </article>

                    <article class="benefit-card" data-reveal data-reveal-atraso="2">
                        <img
                            src="/assets/icons/velocidade-icon.svg"
                            alt=""
                            class="benefit-icon"
                        />
                        <h4>Ultra Velocidade</h4>
                        <p>
                            Faça downloads pesados, envie arquivos grandes e
                            assista a vídeos em 4K ou 8K ao mesmo tempo, sem
                            lentidão.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- SEÇÃO MESH -->
        <section class="section dark-section">
            <div class="container">
                <div class="badge-group">
                    <span>Tecnologia</span>
                    <span class="badge-tag">Mesh</span>
                </div>

                <header class="container-narrow section-header">
                    <h2 class="section-title">Wi-Fi na casa inteira, sem pontos cegos</h2>
                    <p class="section-description">Sabe aquele quarto onde o sinal não pega de jeito nenhum? Esquece! O Wi-Fi Mesh espalha internet boa por toda a casa porque os aparelhinhos trabalham em equipe.</p>
                </header>

                <div class="mesh-image">
                    <img
                        src="/assets/equipamentos/roteador-wifi-mesh.webp"
                        alt="Roteador Wifi Mesh"
                    />
                </div>

                <div class="mesh-highlights">
                    <p>O sinal contorna paredes e obstáculos automaticamente</p>
                    <p>
                        Mova-se pela casa jogando ou em chamada de vídeo sem
                        nenhuma interrupção
                    </p>
                </div>

                <div class="grid-3-cols">
                    <article class="info-card info-card--mesh" data-reveal>
                        <h3>Cobertura uniforme e sem pontos cegos</h3>
                        <p>
                            Ao contrário dos repetidores tradicionais, os
                            módulos Mesh se comunicam entre si para formar uma
                            única rede. Isso elimina as "zonas mortas" de sinal.
                        </p>
                    </article>

                    <article class="info-card info-card--mesh" data-reveal data-reveal-atraso="2">
                        <h3>Transição fluida (Roaming Wi-Fi)</h3>
                        <p>
                            Você pode andar pela casa mudando de cômodo sem que
                            a sua conexão caia ou trave, mantendo um único nome
                            de rede e senha.
                        </p>
                    </article>

                    <article class="info-card info-card--mesh" data-reveal data-reveal-atraso="3">
                        <h3>Fácil gerenciamento e expansão</h3>
                        <p>
                            Controlado por aplicativo simples no celular. Se
                            precisar de mais cobertura, basta adicionar um novo
                            módulo à rede existente.
                        </p>
                    </article>
                </div>
            </div>

            <!-- SEÇÃO MONITORAMENTO -->

            <div class="container">
                <div class="badge-group space-top-padding">
                    <span>Monitoramento</span>
                    <span class="badge-tag">Inteligente</span>
                </div>

                <header class="container-narrow section-header">
                    <h2 class="section-title">Sua vida mais segura com câmera inteligente</h2>
                    <p class="section-description">Você pode ver o que está acontecendo na sua casa direto no celular, tudo guardado de forma mágica na internet, sem precisar gastar com caixas de gravação!</p>
                </header>

                <div class="cards-horizontal-grid">
                    <article class="card-horizontal card-horizontal--nuvem">
                        <h3>Armazenamento 100% em Nuvem</h3>
                        <p>
                            Todas as imagens são gravadas digitalmente com
                            segurança, eliminando DVR ou HD na parede.
                        </p>
                    </article>

                    <article
                        class="card-horizontal card-horizontal--monitoramento"
                    >
                        <h3>Monitoramento em Tempo Real</h3>
                        <p>
                            Acompanhe a movimentação do lar ou negócio de
                            qualquer lugar.
                        </p>
                    </article>

                    <article class="card-horizontal card-horizontal--app">
                        <h3>Aplicativo Exclusivo Zamtech</h3>
                        <p>
                            Acesse o sinal ao vivo e o histórico de gravações a
                            qualquer momento pelo celular.
                        </p>
                    </article>
                </div>
            </div>

            <!-- BANNER CÂMERA -->
            <div class="camera-banner-card">
                <div class="camera-banner-content">
                    <h3 class="camera-banner-title">Câmera de monitoramento</h3>
                    <p class="camera-banner-text">
                        A ZAMTECH disponibiliza a câmera inteligente para
                        utilização na sua casa ou empresa sem que precise de
                        comprar o equipamento. A câmera é cedida como um
                        empréstimo gratuito enquanto o seu plano ou serviço
                        adicional de monitoramento estiver ativo.
                    </p>
                </div>

                <div class="camera-banner-media">
                    <img
                        src="/assets/equipamentos/camera-monitoramento.webp"
                        alt="Câmera de Monitoramento Zamtech"
                        class="camera-banner-img"
                    />
                </div>
            </div>
        </section>
        <!-- VÍDEO MONITORAMENTO -->
        <section class="vid-bg-camera">
            <video
                autoplay
                loop
                muted
                playsinline
                src="/assets/vid/camera-de-monitoramento-zamtech.webm"></video>

            <div class="container vid-bg-camera-copy">
                <img
                    src="/assets/img/cards-imgs/aplicativo-zamtech-img-no-bg.webp"
                    alt="Celular Aplicativo Monitoramento da Zamtech"
                    class="main-cam cam-app-phone"
                />

                <div class="copy-wrapper">
                    <span class="badge-tag monitoramento-nvm"
                        >Monitoramento na Nuvem</span
                    >
                    <h2 class="section-title">
                        Sua casa ao vivo, na palma da sua mão
                    </h2>
                    <p class="section-description">
                        Sem DVR e sem HD. Acompanhe em tempo real e acesse suas
                        gravações salvas em nuvem direto pelo app exclusivo
                        Zamtech.
                    </p>
                </div>
            </div>
        </section>

        <!-- SEÇÃO PABX -->
        <section class="section dark-section">
            <div class="container">
                <div class="badge-group badge-pabx">
                    <span class="badge-tag">PABX</span>
                </div>

                <header class="container-narrow section-header">
                    <h2 class="section-title">
                        Comunicação inteligente para empresas de todas as
                        dimensões
                    </h2>
                    <p class="section-description">
                        Modernize o atendimento do seu negócio com o PABX em
                        Nuvem da ZAMTECH. Elimine centrais físicas, reduza
                        custos de infraestrutura e aceda ao seu sistema a partir
                        de qualquer lugar.
                    </p>
                </header>

                <div class="grid-2-cols">
                    <article class="info-card info-card--light">
                        <h3>Sua Empresa Nunca Fica Fora do Ar</h3>
                        <p>
                            Infraestrutura em nuvem de alta disponibilidade.
                            Proteção total de dados e operação 100% contínua,
                            sem interrupções.
                        </p>
                    </article>

                    <article class="info-card info-card--purple">
                        <h3>Controle e Auditoria em Tempo Real</h3>
                        <p>
                            Acompanhe chamadas, acesse histórico completo e ouça
                            gravações para garantir o padrão de qualidade da sua
                            equipe.
                        </p>
                    </article>

                    <article class="info-card info-card--light">
                        <h3>Atendimento Rápido e Zero Fila</h3>
                        <p>
                            Roteamento inteligente de chamadas, menus
                            personalizados (URA) e distribuição automática para
                            eliminar o tempo de espera.
                        </p>
                    </article>

                    <article class="info-card info-card--purple">
                        <h3>Escritório em Qualquer Lugar</h3>
                        <p>
                            Atenda e faça ligações com o número da sua empresa
                            direto pelo celular ou computador, de onde estiver.
                        </p>
                    </article>

                    <article class="info-card info-card--light">
                        <h3>Crescimento sem Limites Técnicos</h3>
                        <p>
                            Adicione novos ramais, equipes e atendentes em
                            poucos cliques, acompanhando a expansão do seu
                            negócio sem complicação.
                        </p>
                    </article>

                    <article class="info-card info-card--purple">
                        <h3>Corte de Custos Operacionais</h3>
                        <p>
                            Elimine equipamentos físicos caros, manutenção
                            presencial e reduza drasticamente a conta de
                            telefonia da sua empresa.
                        </p>
                    </article>
                </div>

                <div class="pabx-media-container">
                    <div class="pabx-img-wrapper">
                        <img
                            src="/assets/equipamentos/pabx-zamtech.webp"
                            alt="Equipamento PABX Zamtech"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- SEÇÃO B2B / NEGÓCIOS -->
        <section class="section dark-section b2b-section">
            <div class="container">
                <header class="container-narrow section-header">
                    <h2 class="section-title section-title--blue">
                        Zamtech Negócios (B2B)
                    </h2>
                    <h3 class="section-subtitle">
                        Conexão robusta para fazer<br />sua empresa voar
                    </h3>
                </header>

                <div class="b2b-features-card">
                    <div class="b2b-feature-item">
                        <h4 class="feature-title">Infraestrutura de ponta</h4>
                        <p>
                            A empresa passa a contar com uma internet estável
                            100% em Fibra Óptica, além de ter o acompanhamento
                            de um suporte especializado da ZAMTECH.
                        </p>
                    </div>
                    <img
                        src="/assets/icons/line-div.svg"
                        alt=""
                        class="line-div"
                    />
                    <div class="b2b-feature-item">
                        <h4 class="feature-title">Atendimento profissional</h4>
                        <p>
                            Garante uma estrutura de comunicação muito mais
                            eficiente e profissional para o contato com os seus
                            clientes.
                        </p>
                    </div>
                    <img
                        src="/assets/icons/line-div.svg"
                        alt=""
                        class="line-div"
                    />
                    <div class="b2b-feature-item">
                        <h4 class="feature-title">
                            Trabalho remoto facilitado
                        </h4>
                        <p>
                            Sua equipe ganha muito mais mobilidade, já que o
                            sistema permite a integração completa com telefones
                            IP, computadores e smartphones.
                        </p>
                    </div>
                </div>

                <div class="b2b-description-wrapper">
                    <p class="b2b-description">
                        No mundo dos negócios, cada segundo offline é um
                        prejuízo. A Zamtech oferece soluções corporativas com
                        internet de ultra performance, link dedicado e
                        atendimento prioritário para garantir a produtividade da
                        sua equipe.
                    </p>
                    <a href="https://wa.me/5527995057736?text=Ol%C3%A1%21%20Gostaria%20de%20falar%20com%20um%20consultor%20corporativo" target="_blank" class="btn btn-outlined"
                        >Falar com um consultor corporativo</a
                    >
                </div>
            </div>
        </section>

        <!-- PROVA SOCIAL -->
        <section class="section section-tint social-proof-section">
            <div class="container">
                <header class="container-narrow section-header">
                    <h2 class="section-title section-title--blue">
                        O que dizem nossos clientes
                    </h2>
                    <h3 class="section-subtitle section-subtitle--black">
                        Quem usa, recomenda.
                    </h3>
                </header>

                <div class="testimonials-grid">
                    <article class="testimonial-card" data-reveal>
                        <div class="profile-avatar">
                            <img
                                src="/assets/img/profile/micheli-dos-santos.png"
                                alt="Micheli Dos Santos"
                            />
                        </div>
                        <div class="rating-stars">
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                        </div>
                        <blockquote>
                            "A melhor Internet da região, excelente atendimento
                            e prestação de serviços. Velocidade super rápida. E
                            o melhor de tudo é o preço.. que cabe no bolso de
                            qualquer um. Zamtech é top"
                        </blockquote>
                        <cite>Micheli Dos Santos</cite>
                    </article>

                    <article class="testimonial-card" data-reveal data-reveal-atraso="2">
                        <div class="profile-avatar">
                            <img
                                src="/assets/img/profile/taylon.png"
                                alt="Thayllon Quaresma"
                            />
                        </div>
                        <div class="rating-stars">
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                        </div>
                        <blockquote>
                            "Excelente experiência com a Zamtech! Serviço de
                            internet rápido, estável e sem dores de cabeça. O
                            atendimento é impecável. Dá gosto contratar uma
                            empresa assim. Super recomendo!"
                        </blockquote>
                        <cite>Thayllon Quaresma</cite>
                    </article>

                    <article class="testimonial-card" data-reveal data-reveal-atraso="3">
                        <div class="profile-avatar">
                            <img
                                src="/assets/img/profile/eli.png"
                                alt="Elis Mercon"
                            />
                        </div>
                        <div class="rating-stars">
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                            <img src="/assets/icons/star.svg" alt="Estrela" />
                        </div>
                        <blockquote>
                            "Empresa muito boa! Precisei de um suporte técnico e
                            eles já estavam prontos para me atender. Foram com
                            agilidade e confiança, resolvendo minha situação.
                            Parabéns a Zamtech!"
                        </blockquote>
                        <cite>Elis Mercon</cite>
                    </article>
                </div>
            </div>
