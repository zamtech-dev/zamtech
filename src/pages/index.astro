<script>
    // CONSULTA DE VIABILIDADE — CEP + número (igual grandes provedores tipo
    // Nio fazem), que checa a CTO mais próxima cadastrada no SGP. CEP é bem
    // mais preciso que a pessoa digitar o endereço na mão: sem risco de
    // confundir rua com nome repetido em outra cidade. Ver
    // /api/viabilidade/consultar.php pra entender a lógica do lado do servidor.
    // A lógica de consulta em si (mascarar CEP, chamar ViaCEP, chamar nosso
    // backend, redirecionar) mora em src/scripts/viabilidade.ts — mesmo
    // arquivo usado pela barra flutuante em Layout.astro, pra nunca ficarem
    // dessincronizadas.
    import { mascaraCep, consultarViaCep, consultarViabilidade, irParaContratar, WHATSAPP_COMERCIAL } from "../scripts/viabilidade";

    const form = document.getElementById("viabilidade-form") as HTMLFormElement;
    const inputCep = document.getElementById("viabilidade-cep") as HTMLInputElement;
    const inputNumero = document.getElementById("viabilidade-numero") as HTMLInputElement;
    const statusCep = document.getElementById("viabilidade-cep-status") as HTMLParagraphElement;
    const resultado = document.getElementById("viabilidade-resultado") as HTMLDivElement;
    const btnPesquisar = form.querySelector(".viabilidade-search-btn") as HTMLButtonElement;
    const textoBtn = form.querySelector(".viabilidade-search-btn-texto") as HTMLSpanElement;

    function mostrarStatusCep(texto: string, tipo: "ok" | "erro") {
        statusCep.textContent = texto;
        statusCep.className = `viabilidade-cep-status viabilidade-cep-status--${tipo}`;
        statusCep.hidden = false;
    }

    // Enquanto a pessoa digita o CEP: formata "00000-000" e, assim que
    // completar os 8 números, já confirma o endereço na hora (via ViaCEP,
    // de graça, direto do navegador) — assim ela vê "achamos sua rua" antes
    // de nem clicar em Verificar, igual o padrão que grandes provedores usam.
    inputCep.addEventListener("input", () => {
        inputCep.value = mascaraCep(inputCep.value);
        const digitos = inputCep.value.replace(/\D/g, "");

        if (digitos.length < 8) {
            statusCep.hidden = true;
            return;
        }

        mostrarStatusCep("Procurando seu endereço...", "ok");

        consultarViaCep(digitos)
            .then((data) => {
                if (data.erro) {
                    mostrarStatusCep("Não achei esse CEP. Confere se digitou certinho.", "erro");
                    return;
                }
                const partes = [data.logradouro, data.bairro, `${data.localidade}/${data.uf}`].filter(Boolean);
                mostrarStatusCep(`✓ ${partes.join(", ")}`, "ok");
            })
            .catch(() => {
                mostrarStatusCep("Não consegui confirmar o CEP agora, mas pode tentar Verificar mesmo assim.", "erro");
            });
    });

    function mostrarResultado(html: string, tipo: "sucesso" | "erro" | "aviso") {
        resultado.innerHTML = html;
        resultado.className = `viabilidade-resultado viabilidade-resultado--${tipo}`;
        resultado.hidden = false;
    }

    function montarFormularioLead(endereco: string, motivo: string): string {
        return `
            <form class="viabilidade-lead-form" data-endereco="${encodeURIComponent(endereco)}" data-motivo="${motivo}">
                <input type="text" name="nome" placeholder="Seu nome" required />
                <input type="text" name="contato" placeholder="WhatsApp ou email" required />
                <button type="submit" class="btn btn-primary">Quero ser avisado</button>
                <p class="viabilidade-lead-erro" hidden></p>
            </form>
            <p class="viabilidade-lead-confirmacao" hidden>Prontinho! Anotamos seu contato e te avisamos assim que tiver novidade.</p>
        `;
    }

    function ativarFormularioLead(enderecoPesquisado: string) {
        const leadForm = resultado.querySelector(".viabilidade-lead-form") as HTMLFormElement | null;
        if (!leadForm) return;

        leadForm.addEventListener("submit", async (ev) => {
            ev.preventDefault();
            const nome = (leadForm.querySelector('[name="nome"]') as HTMLInputElement).value.trim();
            const contato = (leadForm.querySelector('[name="contato"]') as HTMLInputElement).value.trim();
            const motivo = leadForm.dataset.motivo || "sem_cobertura";
            const enderecoLead = leadForm.dataset.endereco ? decodeURIComponent(leadForm.dataset.endereco) : enderecoPesquisado;
            const btnLead = leadForm.querySelector("button") as HTMLButtonElement;
            const erroLead = leadForm.querySelector(".viabilidade-lead-erro") as HTMLParagraphElement;

            btnLead.disabled = true;
            btnLead.textContent = "Enviando...";
            erroLead.hidden = true;

            try {
                const respLead = await fetch("/api/viabilidade/lead.php", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ nome, contato, endereco: enderecoLead, motivo }),
                });
                const dataLead = await respLead.json();
                const confirmacao = resultado.querySelector(".viabilidade-lead-confirmacao") as HTMLParagraphElement;

                if (dataLead.sucesso) {
                    leadForm.hidden = true;
                    confirmacao.hidden = false;
                } else {
                    btnLead.disabled = false;
                    btnLead.textContent = "Quero ser avisado";
                    erroLead.textContent = dataLead.mensagem || "Não consegui enviar seu contato agora. Tenta de novo.";
                    erroLead.hidden = false;
                }
            } catch (error) {
                btnLead.disabled = false;
                btnLead.textContent = "Quero ser avisado";
                erroLead.textContent = "Não consegui falar com o servidor agora. Tenta de novo em instantes.";
                erroLead.hidden = false;
            }
        });
    }

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const cep = inputCep.value.replace(/\D/g, "");
        const numero = inputNumero.value.trim();

        if (cep.length !== 8) {
            mostrarStatusCep("Digite um CEP válido (8 números).", "erro");
            return;
        }
        if (numero === "") {
            mostrarResultado("<p>Digite o número da casa ou prédio.</p>", "erro");
            return;
        }

        btnPesquisar.disabled = true;
        textoBtn.textContent = "Buscando...";
        resultado.hidden = true;

        // Usado como identificação do lead se a busca cair em sem cobertura/vaga.
        const enderecoParaLead = `CEP ${inputCep.value}, nº ${numero}`;

        try {
            const data = await consultarViabilidade(cep, numero);
            const enderecoEncontrado = data.endereco_encontrado || enderecoParaLead;

            if (!data.sucesso) {
                mostrarResultado(`<p>${data.mensagem}</p>`, "erro");
            } else if (data.atende) {
                // Atende -> já manda direto pra página de planos/contratação,
                // sem precisar de mais um clique. O CEP/número resolvidos vão
                // na URL pra /contratar não precisar perguntar de novo.
                textoBtn.textContent = "Encontramos! Redirecionando...";
                mostrarResultado(`<p>${data.mensagem}</p>`, "sucesso");
                irParaContratar(cep, numero);
                return;
            } else if (data.motivo === "endereco_nao_encontrado" || data.motivo === "cep_nao_encontrado") {
                mostrarResultado(`
                    <p>${data.mensagem}</p>
                    <a href="${WHATSAPP_COMERCIAL}" target="_blank" rel="noopener noreferrer" class="btn btn-outlined-light">Falar no WhatsApp</a>
                `, "aviso");
            } else {
                // sem_cobertura ou sem_vaga -> mostra a mensagem e já oferece
                // captura de contato, pra Carol saber da demanda na região.
                mostrarResultado(`
                    <p>${data.mensagem}</p>
                    ${data.endereco_encontrado ? `<p class="viabilidade-endereco-confirmado">${data.endereco_encontrado}</p>` : ""}
                    ${montarFormularioLead(enderecoEncontrado, data.motivo || "sem_cobertura")}
                `, "aviso");
                ativarFormularioLead(enderecoEncontrado);
            }
        } catch (error) {
            mostrarResultado(`
                <p>Não consegui falar com o servidor agora. Tenta de novo em instantes ou fala com a gente:</p>
                <a href="${WHATSAPP_COMERCIAL}" target="_blank" rel="noopener noreferrer" class="btn btn-outlined-light">Falar no WhatsApp</a>
            `, "erro");
        } finally {
            btnPesquisar.disabled = false;
            textoBtn.textContent = "Verificar";
        }
    });
</script>

