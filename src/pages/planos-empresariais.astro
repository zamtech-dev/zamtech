<script>
    document.addEventListener("DOMContentLoaded", () => {
        const tabConectividade = document.getElementById("tab-conectividade");
        const tabPabx = document.getElementById("tab-pabx");
        const gridConectividade = document.getElementById("grid-conectividade");
        const gridPabx = document.getElementById("grid-pabx");

        if (tabConectividade && tabPabx && gridConectividade && gridPabx) {
            tabConectividade.addEventListener("click", () => {
                tabConectividade.classList.add("active");
                tabPabx.classList.remove("active");
                gridConectividade.classList.remove("hidden");
                gridPabx.classList.add("hidden");
            });

            tabPabx.addEventListener("click", () => {
                tabPabx.classList.add("active");
                tabConectividade.classList.remove("active");
                gridPabx.classList.remove("hidden");
                gridConectividade.classList.add("hidden");
            });
        }
    });
</script>

<style>
    /* 1. HERO EMPRESARIAL */
    .hero-empresarial {
        position: relative;
        padding: var(--space-64) 0;
        background-image: url('/assets/img/backgrounds/background-planos-empresariais.jpg');
        background-size: cover;
        background-position: center top 10%;
        color: var(--color-white);
        min-height: 700px;
        display: flex;
        align-items: center;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: #000000a9;
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 820px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-16);
    }

    .badge-hero {
        display: inline-flex;
        align-items: center;
        gap: var(--space-8);
        padding: 6px 16px;
        background-color: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: var(--radius-full);
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--color-white);
    }

    .hero-content h1 {
        font-size: clamp(2rem, 4vw, var(--fs-h1));
        line-height: 1.15;
    }

    .hero-subtitle {
        font-size: var(--fs-body);
        color: var(--color-gray-low);
        line-height: 1.6;
        max-width: 720px;
    }

    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-16);
        margin-top: var(--space-12);
    }

    .btn-yellow {
        background-color: var(--color-secondary);
        color: var(--color-white);
        font-weight: 700;
    }

    .btn-yellow:hover {
        background-color: var(--color-primary);
    }

    /* 2. SEÇÃO DE PLANOS B2B & SWITCH */
    .section-planos {
        background-color: var(--color-white);
    }

    .header-planos {
        text-align: center;
        max-width: 720px;
        margin: 0 auto var(--space-48);
    }

    .subtitulo-tag {
        font-size: var(--fs-caption);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-primary);
        letter-spacing: 1px;
    }

    .subtitulo-tag-blue {
        font-size: var(--fs-caption);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-secondary);
        letter-spacing: 1px;
    }

    .titulo-secao-local {
        font-size: var(--fs-h2);
        color: var(--color-dark-blue);
        margin: var(--space-4) 0 var(--space-12);
    }

    .desc-secao {
        color: var(--color-gray-medium);
        font-size: var(--fs-body);
    }

    /* Switch de Categorias */
    .switch-container {
        display: inline-flex;
        background-color: var(--color-gray-light);
        padding: 6px;
        border-radius: var(--radius-full);
        gap: var(--space-8);
        margin-top: var(--space-24);
        border: 1px solid #e2e8f0;
    }

    .switch-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-8);
        padding: 12px 24px;
        border-radius: var(--radius-full);
        font-size: var(--fs-sm);
        font-weight: 700;
        color: var(--color-gray-medium);
        transition: var(--transition-default);
        cursor: pointer;
        border: none;
        background: transparent;
    }

    .switch-btn.active {
        background-color: var(--color-primary);
        color: var(--color-white);
        box-shadow: var(--elevation-1);
    }

    .badge-pop {
        background-color: var(--color-yellow);
        color: var(--color-black);
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: var(--radius-full);
        font-weight: 800;
    }

    /* Grids de Planos */
    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: var(--space-32);
    }

    .plans-grid.hidden {
        display: none !important;
    }

    /* 3. TABELA DE SERVIÇOS B2B */
    .section-servicos-b2b {
        background-color: var(--color-gray-light);
    }

    .servicos-header {
        text-align: center;
        max-width: 700px;
        margin: 0 auto var(--space-48);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        background-color: var(--color-white);
        border-radius: var(--radius-lg);
        box-shadow: var(--elevation-1);
        border: 1px solid #e2e8f0;
    }

    .b2b-services-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: var(--fs-sm);
    }

    .b2b-services-table th,
    .b2b-services-table td {
        padding: var(--space-16) var(--space-24);
        border-bottom: 1px solid var(--color-gray-light);
    }

    .b2b-services-table th {
        background-color: var(--color-dark-blue);
        color: var(--color-white);
        font-family: var(--font-display);
        font-weight: 700;
        text-transform: uppercase;
        font-size: var(--fs-caption);
        letter-spacing: 0.5px;
    }

    .b2b-services-table tr:last-child td {
        border-bottom: none;
    }

    .price-highlight {
        font-weight: 700;
        color: var(--color-primary);
    }

    .badge-courtesy {
        display: inline-block;
        padding: 4px 12px;
        background-color: rgba(7, 86, 255, 0.12);
        color: var(--color-secondary);
        font-weight: 800;
        font-size: var(--fs-caption);
        border-radius: var(--radius-full);
    }

    .badge-included {
        display: inline-block;
        padding: 4px 12px;
        background-color: rgba(3, 37, 208, 0.1);
        color: var(--color-primary);
        font-weight: 800;
        font-size: var(--fs-caption);
        border-radius: var(--radius-full);
    }

    .highlight-row {
        background-color: rgba(3, 37, 208, 0.02);
