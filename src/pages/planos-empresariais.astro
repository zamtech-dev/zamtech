                        "Relatórios completos e relatórios de desempenho",
                        "Suporte corporativo prioritário 24/7"
                    ]}
                    adicionais={[
                        { nome: "PABX em Nuvem Enterprise", preco: 0, incluso: true },
                        { nome: "Ramal Adicional", preco: 7.90 },
                        { nome: "Número Telefônico (DID)", preco: 29.90 },
                        { nome: "Gravação Estendida", preco: 19.90 }
                    ]}
                />

                <CardPlano
                    nome="PABX START - Essential"
                    velocidade="Telefonia Cloud Avulsa"
                    precoBase={49.90}
