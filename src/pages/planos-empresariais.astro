                    recursos={[
                        "Até 5 Ramais internos/externos",
                        "Softphone para PC e Celular",
                        "URA Básica de Atendimento",
                        "Transferência e histórico de chamadas"
                    ]}
                    adicionais={[
                        { nome: "Ramal Adicional", preco: 7.90 },
                        { nome: "Número Telefônico (DID)", preco: 29.90 },
                        { nome: "Gravação Estendida", preco: 19.90 }
                    ]}
                />

                <CardPlano
                    nome="PABX BUSINESS - Pro"
                    velocidade="Telefonia Cloud Avulsa"
                    precoBase={79.90}
                    descricao="Recursos avançados para empresas com fluxo intenso de chamadas e necessidade de gestão de equipe."
                    recursos={[
                        "Até 10 Ramais inclusos",
                        "URA Personalizada + Filas de espera",
                        "Gravação de ligações inclusa",
                        "Painel Administrativo Web completo"
                    ]}
                    adicionais={[
                        { nome: "Ramal Adicional", preco: 7.90 },
                        { nome: "Número Telefônico (DID)", preco: 29.90 },
                        { nome: "Gravação Estendida", preco: 19.90 }
                    ]}
                />

                <CardPlano
                    nome="PABX ENTERPRISE - Infinity"
                    velocidade="Telefonia Cloud Avulsa"
                    precoBase={129.90}
                    descricao="Comunicação sem limites de ramais para grandes operações, relatórios e integrações de sistema."
                    recursos={[
                        "Capacidade de Ramais Ilimitados*",
                        "URA Avançada com horários flexíveis",
                        "Filas inteligentes de atendimento",
                        "API para integração com CRMs e sistemas"
                    ]}
                    adicionais={[
                        { nome: "Ramal Adicional", preco: 7.90 },
                        { nome: "Número Telefônico (DID)", preco: 29.90 },
                        { nome: "Gravação Estendida", preco: 19.90 }
                    ]}
                />
            </div>
        </div>
    </section>

    <section class="section section-servicos-b2b">
        <div class="container">
            <div class="servicos-header">
                <span class="subtitulo-tag-blue">Transparência em Cada Detalhe</span>
                <h2>Serviços e Adicionais Corporativos</h2>
                <p>
                    Ajuste e expansão da sua estrutura de comunicação conforme a necessidade do seu negócio.
                </p>
            </div>

            <div class="table-responsive">
                <table class="b2b-services-table">
                    <thead>
                        <tr>
                            <th>Serviço / Recurso</th>
                            <th>Descrição / Benefício</th>
                            <th>Valor / Condição</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Ramal Adicional (PABX)</strong></td>
                            <td>Adicione novos pontos de atendimento para colaboradores no celular, PC ou fone IP.</td>
                            <td><span class="price-highlight">R$ 7,90 /mês</span></td>
                        </tr>
                        <tr>
                            <td><strong>Número Telefônico (DID)</strong></td>
                            <td>Número fixo exclusivo para receber chamadas diretas da sua cidade/região.</td>
                            <td><span class="price-highlight">R$ 29,90 /mês</span></td>
                        </tr>
                        <tr>
                            <td><strong>Gravação Estendida (PABX)</strong></td>
                            <td>Armazenamento ampliado de áudios de ligações para auditoria e treinamento.</td>
                            <td><span class="price-highlight">R$ 19,90 /mês</span></td>
                        </tr>
                        <tr class="highlight-row">
                            <td><strong>Configuração Inicial do PABX</strong></td>
                            <td>Mapeamento de ramais, criação de URA e rotas de atendimento pela nossa equipe técnica.</td>
                            <td><span class="badge-courtesy">CORTESIA</span></td>
                        </tr>
                        <tr class="highlight-row">
                            <td><strong>Treinamento Remoto de Equipe</strong></td>
