                        { nome: "Ramal Adicional", preco: 7.90 },
                        { nome: "Número Telefônico (DID)", preco: 29.90 },
                        { nome: "Gravação Estendida", preco: 19.90 }
                    ]}
                />

                <CardPlano
                    nome="Empresarial 1G - PABX Elite"
                    velocidade="1 Giga + PABX Enterprise"
                    precoBase={349.90}
                    badge="PERFORMANCE CORPORATIVA"
                    descricao="Estrutura completa sem limites para empresas que exigem máxima disponibilidade em voz e dados."
                    isFeatured={true}
                    recursos={[
                        "1 Giga de Internet Banda Larga",
