---
import Layout from "../layouts/Layout.astro";
import CardPlano from "../components/CardPlano.astro";
import "../styles/global.css";

// Adicionais Corporativos Padrão para os cards
const adicionaisEmpresarialPadrao = [
    { nome: "Linha Telefônica (Voz)", preco: 29.90 },
    { nome: "Câmera Inteligente Nuvem", preco: 39.90 },
    { nome: "Ponto Wi-Fi Mesh B2B", preco: 39.90 },
    { nome: "PABX em Nuvem Essential", preco: 49.90 }
];
---

<Layout title="Planos Empresariais - Zamtech Fibra Óptica">
    <section class="hero-empresarial">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <span class="badge-hero">
                <img src="/assets/icons/others-icons/empresarial-white.svg" alt="Empresarial" width="18" height="18" />
                Zamtech para Empresas
            </span>
            <h1>Sua empresa não pode parar, e o seu cliente não pode esperar</h1>
            <p class="hero-subtitle">
                Nosso compromisso vai além de conectar o seu negócio: <strong>nosso foco são os clientes dos seus clientes.</strong> Garantimos a estabilidade necessária para pagamentos via PIX, emissão de NFe, Wi-Fi corporativo e comunicação sem interrupções.
            </p>
            <div class="hero-buttons">
                <a href="#planos-b2b" class="btn btn-yellow">
                    Ver Planos Corporativos
                </a>
                <a href="https://wa.me/5527995057736?text=Ol%C3%A1%21%20Gostaria%20de%20falar%20com%20um%20consultor%20B2B." class="btn btn-outlined" target="_blank">
                    Falar com Consultor B2B
                </a>
            </div>
        </div>
    </section>

    <section id="planos-b2b" class="section section-planos">
        <div class="container">
            <div class="header-planos">
                <span class="subtitulo-tag">Soluções em Conectividade & Voz</span>
                <h2 class="titulo-secao-local">Planos Projetados para o Seu Negócio</h2>
                <p class="desc-secao">
                    Escolha a categoria ideal para a infraestrutura, comunicação e segurança da sua empresa.
                </p>

                <div class="switch-container">
                    <button id="tab-conectividade" class="switch-btn active">
                        Conectividade & Combos
                    </button>
                    <button id="tab-pabx" class="switch-btn">
                        PABX & Telefonia Cloud
                        <span class="badge-pop">Especial B2B</span>
                    </button>
                </div>
            </div>

            <div id="grid-conectividade" class="plans-grid">
                
                <CardPlano
                    nome="Empresarial 600 - Start"
                    velocidade="600 Mega 100% Fibra"
                    precoBase={119.90}
                    descricao="Ideal para pequenos negócios, escritórios e consultórios que necessitam de estabilidade para PDV, NFe e emissão de notas."
                    recursos={[
                        "600 Mega de Download e Upload",
                        "Garantia de banda para sistemas em nuvem",
                        "Suporte Técnico prioritário B2B",
                        "Instalação e configuração grátis"
                    ]}
                    adicionais={adicionaisEmpresarialPadrao}
                />

                <CardPlano
                    nome="Empresarial 850 - Escala Voice"
                    velocidade="850 Mega + 1 Linha Fixa"
                    precoBase={189.90}
                    badge="MAIS VENDIDO PARA EMPRESAS"
                    descricao="Alta velocidade combinada com telefonia fixa profissional para otimizar o atendimento de lojas e empresas em crescimento."
                    isFeatured={true}
                    recursos={[
                        "850 Mega 100% Fibra Óptica",
                        "1 Linha Telefônica Fixa inclusa",
                        "Suporte Especializado B2B",
                        "Atendimento ao cliente com qualidade HD"
                    ]}
                    adicionais={[
                        { nome: "Linha Telefônica (Voz)", preco: 0, incluso: true },
                        { nome: "Câmera Inteligente Nuvem", preco: 39.90 },
                        { nome: "Ponto Wi-Fi Mesh B2B", preco: 39.90 },
                        { nome: "PABX em Nuvem Essential", preco: 49.90 }
                    ]}
                />

                <CardPlano
                    nome="Empresarial 1G - Prime Secure"
                    velocidade="1 Giga + Voz + Câmera Nuvem"
                    precoBase={239.90}
                    badge="SOLUÇÃO COMPLETA B2B"
                    descricao="Conectividade máxima, linha de atendimento comercial e monitoramento inteligente salvo 100% em nuvem."
                    isFeatured={true}
                    recursos={[
                        "1 Gbps (1.000 Mega) de Ultravelocidade",
                        "1 Linha Telefônica Fixa B2B",
                        "1 Câmera de Monitoramento em Nuvem",
                        "Acesso ao vivo e gravações pelo App Zamtech"
                    ]}
                    adicionais={[
                        { nome: "Linha Telefônica (Voz)", preco: 0, incluso: true },
                        { nome: "Câmera Inteligente Nuvem", preco: 0, incluso: true },
                        { nome: "Ponto Wi-Fi Mesh B2B", preco: 39.90 },
                        { nome: "PABX em Nuvem Essential", preco: 49.90 }
                    ]}
                />

                <CardPlano
                    nome="Empresarial 850 - Escala"
                    velocidade="850 Mega 100% Fibra"
                    precoBase={159.90}
                    descricao="Projetado para empresas que conectam dezenas de colaboradores, computadores e dispositivos móveis simultaneamente."
                    recursos={[
                        "850 Mega de Ultravelocidade",
                        "Estabilidade reforçada para chamadas de vídeo",
                        "Upload de alta velocidade para backup",
                        "Atendimento corporativo ágil"
                    ]}
                    adicionais={adicionaisEmpresarialPadrao}
                />

                <CardPlano
                    nome="Empresarial 1G - Prime"
                    velocidade="1 Giga 100% Fibra"
                    precoBase={169.90}
                    descricao="Máxima capacidade de tráfego para empresas de tecnologia, agências, coworkings e negócios que não aceitam gargalos."
