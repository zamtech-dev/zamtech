---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Assinar Zamtech - Indique e Ganhe">
    <section class="section-dark section assinar-hero">
        <div class="container assinar-hero-content">
            <span class="chip-brand">Você foi indicado</span>
            <h1>Falta pouco! Complete seus dados <span class="text-gradient">e agende sua instalação</span></h1>
            <p class="assinar-hero-subtitle">
                Você foi indicado por um cliente Zamtech. Preencha seus dados abaixo e nosso time comercial entra em contato pra agendar a instalação da sua internet.
            </p>
        </div>
    </section>

    <section class="section form-section">
        <div class="container">
            <div class="form-wrapper card-padrao">
                <div id="statusLink" class="status-link"></div>

                <form id="formAssinar" class="assinar-form" hidden>
                    <div class="input-group">
                        <label for="nomeIndicado">Nome completo</label>
                        <input type="text" id="nomeIndicado" required placeholder="Digite seu nome completo" autocomplete="name" />
                    </div>

                    <div class="input-row">
                        <div class="input-group">
                            <label for="cpfIndicado">CPF</label>
                            <input type="text" id="cpfIndicado" required placeholder="000.000.000-00" inputmode="numeric" maxlength="14" autocomplete="off" />
                            <span class="input-erro" id="cpfIndicadoErro" hidden>CPF inválido. Confira os números digitados.</span>
                        </div>

                        <div class="input-group">
                            <label for="telefoneIndicado">Celular (WhatsApp)</label>
                            <input type="text" id="telefoneIndicado" required placeholder="(00) 00000-0000" inputmode="numeric" maxlength="15" autocomplete="tel" />
                        </div>
                    </div>

                    <p class="secao-titulo">Endereço de instalação</p>

                    <div class="input-row">
                        <div class="input-group input-group--cep">
                            <label for="cepIndicado">CEP</label>
                            <input type="text" id="cepIndicado" required placeholder="00000-000" inputmode="numeric" maxlength="9" autocomplete="off" />
                        </div>
                        <div class="input-group input-group--uf">
                            <label for="ufIndicado">UF</label>
                            <input type="text" id="ufIndicado" required placeholder="ES" maxlength="2" autocomplete="off" />
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="logradouroIndicado">Endereço (rua/avenida)</label>
                        <input type="text" id="logradouroIndicado" required placeholder="Rua, avenida..." autocomplete="off" />
                    </div>

                    <div class="input-row">
                        <div class="input-group">
                            <label for="numeroIndicado">Número</label>
                            <input type="text" id="numeroIndicado" required placeholder="Nº" autocomplete="off" />
                        </div>
                        <div class="input-group">
                            <label for="complementoIndicado">Complemento</label>
                            <input type="text" id="complementoIndicado" placeholder="Apto, bloco... (opcional)" autocomplete="off" />
                        </div>
                    </div>

                    <div class="input-row">
                        <div class="input-group">
                            <label for="bairroIndicado">Bairro</label>
                            <input type="text" id="bairroIndicado" required placeholder="Bairro" autocomplete="off" />
                        </div>
                        <div class="input-group">
                            <label for="cidadeIndicado">Cidade</label>
                            <input type="text" id="cidadeIndicado" required placeholder="Cidade" autocomplete="off" />
                        </div>
                    </div>

                    <label class="checkbox-group">
                        <input type="checkbox" id="termosAssinar" required />
                        <span>Li e concordo com o <a href="/regulamento-indique-e-ganhe" target="_blank">Regulamento do Indique e Ganhe</a> e com a <a href="/politica-de-privacidade" target="_blank">Política de Privacidade</a> da Zamtech.</span>
                    </label>

                    <button type="submit" class="btn btn-primary btn-lg" id="btnAssinar">Quero agendar minha instalação</button>
                </form>

                <div id="mensagemAssinar" class="mensagem-retorno-indique hidden"></div>
            </div>
        </div>
    </section>
</Layout>

<script>
    function validarCPF(valor: string): boolean {
        const cpf = valor.replace(/[^\d]/g, "");
        if (cpf.length !== 11 || /^(\d)\1{10}$/.test(cpf)) return false;

        let soma = 0;
        for (let i = 0; i < 9; i++) soma += parseInt(cpf[i]) * (10 - i);
        let resto = (soma * 10) % 11;
        if (resto === 10 || resto === 11) resto = 0;
        if (resto !== parseInt(cpf[9])) return false;

        soma = 0;
        for (let i = 0; i < 10; i++) soma += parseInt(cpf[i]) * (11 - i);
        resto = (soma * 10) % 11;
        if (resto === 10 || resto === 11) resto = 0;
        if (resto !== parseInt(cpf[10])) return false;

        return true;
    }

    function mascararCPF(valor: string): string {
        return valor.replace(/[^\d]/g, "").slice(0, 11)
            .replace(/(\d{3})(\d)/, "$1.$2")
            .replace(/(\d{3})(\d)/, "$1.$2")
            .replace(/(\d{3})(\d{1,2})$/, "$1-$2");
    }

    function mascararTelefone(valor: string): string {
        return valor.replace(/[^\d]/g, "").slice(0, 11)
            .replace(/(\d{2})(\d)/, "($1) $2")
            .replace(/(\d{5})(\d{1,4})$/, "$1-$2");
    }

    function mascararCEP(valor: string): string {
        return valor.replace(/[^\d]/g, "").slice(0, 8)
            .replace(/(\d{5})(\d{1,3})$/, "$1-$2");
    }

    const statusLink = document.getElementById("statusLink") as HTMLElement;
    const form = document.getElementById("formAssinar") as HTMLFormElement;
    const mensagemAssinar = document.getElementById("mensagemAssinar") as HTMLElement;
    const btnAssinar = document.getElementById("btnAssinar") as HTMLButtonElement;

    const cpfInput = document.getElementById("cpfIndicado") as HTMLInputElement;
    const cpfErro = document.getElementById("cpfIndicadoErro") as HTMLElement;
    const telefoneInput = document.getElementById("telefoneIndicado") as HTMLInputElement;
    const cepInput = document.getElementById("cepIndicado") as HTMLInputElement;
    const ufInput = document.getElementById("ufIndicado") as HTMLInputElement;

    cpfInput?.addEventListener("input", () => {
        cpfInput.value = mascararCPF(cpfInput.value);
        cpfErro.hidden = true;
    });
    telefoneInput?.addEventListener("input", () => { telefoneInput.value = mascararTelefone(telefoneInput.value); });
    cepInput?.addEventListener("input", () => { cepInput.value = mascararCEP(cepInput.value); });
    ufInput?.addEventListener("input", () => { ufInput.value = ufInput.value.toUpperCase().slice(0, 2); });

    function mostrarMensagem(html: string, negativo = false) {
        mensagemAssinar.innerHTML = html;
        mensagemAssinar.classList.remove("hidden");
        mensagemAssinar.classList.toggle("negativa", negativo);
    }

    const params = new URLSearchParams(window.location.search);
    const ref = (params.get("ref") || "").trim();

    async function iniciar() {
        if (!ref) {
            statusLink.innerHTML = `<p class="status-link-erro">Esse link está incompleto. Peça o link de indicação certo pra quem te indicou pra Zamtech.</p>`;
            return;
        }

        statusLink.innerHTML = `<p class="status-link-carregando">Confirmando seu link de indicação...</p>`;

        try {
            const response = await fetch("/api/indique/validar-ref.php", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ref }),
            });
            const data = await response.json();

            if (data.valido) {
                statusLink.innerHTML = "";
                form.hidden = false;
            } else {
                statusLink.innerHTML = `<p class="status-link-erro">${data.mensagem || "Esse link de indicação não é válido."}</p>`;
            }
        } catch (error) {
            statusLink.innerHTML = `<p class="status-link-erro">Não consegui confirmar o link agora. Recarregue a página em instantes.</p>`;
        }
    }

    iniciar();

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const cpf = cpfInput.value.trim();
            if (!validarCPF(cpf)) {
                cpfErro.hidden = false;
                cpfInput.focus();
                return;
            }
            cpfErro.hidden = true;

            const dados = {
                ref,
                nome: (document.getElementById("nomeIndicado") as HTMLInputElement).value.trim(),
                cpf,
                telefone: telefoneInput.value.trim(),
                cep: cepInput.value.trim(),
                uf: ufInput.value.trim(),
                logradouro: (document.getElementById("logradouroIndicado") as HTMLInputElement).value.trim(),
                numero: (document.getElementById("numeroIndicado") as HTMLInputElement).value.trim(),
                complemento: (document.getElementById("complementoIndicado") as HTMLInputElement).value.trim(),
                bairro: (document.getElementById("bairroIndicado") as HTMLInputElement).value.trim(),
                cidade: (document.getElementById("cidadeIndicado") as HTMLInputElement).value.trim(),
            };

            btnAssinar.disabled = true;
            btnAssinar.textContent = "Enviando seus dados...";
            mensagemAssinar.classList.add("hidden");

            try {
                const response = await fetch("/api/indique/cadastrar-indicado.php", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(dados),
                });
                const data = await response.json();

                if (data.sucesso) {
                    mostrarMensagem(`<p>${data.mensagem}</p>`, false);
                    form.hidden = true;
                } else {
                    const ehErroDeSistema = data.tipo === "erro";
                    let html = `<p>${data.mensagem || "Não consegui enviar seu cadastro agora."}</p>`;
                    if (ehErroDeSistema) {
                        html += `<a href="https://wa.me/5527995057736" target="_blank" rel="noopener noreferrer" class="btn btn-outlined-light">Falar no WhatsApp</a>`;
                    }
                    mostrarMensagem(html, !ehErroDeSistema);
                }
            } catch (error) {
                mostrarMensagem(`
                    <p>Não consegui falar com o servidor agora. Tenta de novo em instantes ou fala com a gente:</p>
                    <a href="https://wa.me/5527995057736" target="_blank" rel="noopener noreferrer" class="btn btn-outlined-light">Falar no WhatsApp</a>
                `, false);
            } finally {
                btnAssinar.disabled = false;
                btnAssinar.textContent = "Quero agendar minha instalação";
            }
        });
    }
</script>

<style>
    .assinar-hero {
        text-align: center;
    }

    .assinar-hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-16);
        max-width: 720px;
        margin: 0 auto;
    }

    .assinar-hero h1 {
        font-size: clamp(2rem, 4vw, var(--fs-h1));
        line-height: 1.2;
    }

    .assinar-hero-subtitle {
        font-size: var(--fs-body);
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.6;
        max-width: 600px;
    }

    .form-section {
        background-color: var(--color-gray-light);
    }

    .form-wrapper {
        max-width: 560px;
        margin: 0 auto;
        background-color: var(--color-white);
        border: 1px solid var(--color-gray-light);
        color: var(--color-gray-dark);
    }

    .status-link-carregando {
        text-align: center;
        color: var(--color-gray-medium);
        font-size: var(--fs-sm);
    }

    .status-link-erro {
        text-align: center;
        color: #b91c1c;
        font-size: var(--fs-sm);
        font-weight: 600;
        background: #fef2f2;
        border: 1px solid rgba(220, 38, 38, 0.3);
        border-radius: var(--radius-sm);
        padding: var(--space-16);
    }

    .assinar-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
    }

    .secao-titulo {
        font-size: var(--fs-sm);
        font-weight: 700;
        color: var(--color-dark-blue);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-top: var(--space-8);
    }

    .input-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
    }

    .input-group--cep {
        grid-column: span 1;
    }

    .input-group--uf {
        grid-column: span 1;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    .input-group label {
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--color-gray-dark);
    }

    .input-group input {
        width: 100%;
        padding: var(--space-12) var(--space-16);
        border: 1px solid var(--color-gray-low);
        border-radius: var(--radius-sm);
        font-size: var(--fs-body);
        font-family: inherit;
        transition: border-color 0.2s ease;
    }

    .input-group input:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(3, 37, 208, 0.12);
    }

    .input-erro {
        display: block;
        margin-top: var(--space-4);
        font-size: var(--fs-caption);
        line-height: 1.5;
        color: #dc2626;
    }

    .input-erro[hidden] {
        display: none;
    }

    .checkbox-group {
        display: flex;
        align-items: flex-start;
        gap: var(--space-8);
        line-height: 1.5;
        font-size: var(--fs-caption);
        color: var(--color-gray-medium);
        cursor: pointer;
    }

    .checkbox-group input {
        margin-top: 3px;
        flex-shrink: 0;
        accent-color: var(--color-primary);
    }

    .checkbox-group a {
        color: var(--color-primary);
        text-decoration: underline;
        font-weight: 600;
    }

    .mensagem-retorno-indique {
        margin-top: var(--space-16);
        padding: var(--space-12) var(--space-16);
        border-radius: var(--radius-sm);
        background: var(--gradient-brand-soft);
        border: 1px solid rgba(3, 37, 208, 0.2);
        color: var(--color-primary);
        font-size: var(--fs-sm);
        font-weight: 600;
        text-align: center;
    }

    .mensagem-retorno-indique.hidden {
        display: none;
    }

    .mensagem-retorno-indique.negativa {
        background: #fef2f2;
        border-color: rgba(220, 38, 38, 0.3);
        color: #b91c1c;
    }

    .mensagem-retorno-indique p {
        margin-bottom: var(--space-12);
    }

    .mensagem-retorno-indique .btn {
        width: 100%;
    }

    .btn-outlined-light {
        border: 1px solid var(--color-primary);
        color: var(--color-primary);
        background-color: transparent;
    }

    .btn-outlined-light:hover {
        background-color: rgba(3, 37, 208, 0.08);
    }

    .btn-lg {
        min-height: 52px;
        padding: 0 var(--space-32);
    }

    @media (max-width: 600px) {
        .input-row {
            grid-template-columns: 1fr;
        }
    }
</style>
