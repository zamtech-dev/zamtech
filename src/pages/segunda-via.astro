---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Segunda Via - Zamtech Fibra Óptica">
    <main class="segunda-via-page">
        <div class="blob blob-purple"></div>
        <div class="blob blob-blue"></div>

        <div class="container-hero">
            <div class="hero-header">
                <h1>Consulte sua <strong>2ª Via</strong></h1>
                <p>Digite seu CPF ou CNPJ abaixo para localizar faturas em aberto com rapidez e segurança.</p>
            </div>

            <div class="search-box-wrapper">
                <form id="formSegundaViaModal" class="search-pill-form">
                    <div class="input-icon-group">
                        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input
                            type="text"
                            id="cpfCnpjModalInput"
                            placeholder="Digite seu CPF ou CNPJ..."
                            required
                            maxlength="18"
                        />
                    </div>
                    <button
                        type="submit"
                        id="btnBuscarModal"
                        class="btn-search-pill"
                    >
                        Buscar Faturas
                    </button>
                </form>
            </div>

            <div id="loadingModal" class="loading-state" style="display:none;">
                <div class="spinner"></div>
                <span>Buscando faturas no sistema...</span>
            </div>

            <!-- Container do Filtro de Mês -->
            <div id="filtroMesContainer" style="display:none; width:100%; margin-top:24px;">
                <div class="filtro-wrapper">
                    <label for="selectMes" class="filtro-label">📅 Filtrar por mês de vencimento:</label>
                    <select id="selectMes" class="filtro-select">
                        <option value="todos">Todas as faturas em aberto</option>
                    </select>
                </div>
            </div>

            <div id="resultadoFaturasModal" class="resultado-container"></div>
        </div>
    </main>
</Layout>

<script>
    let faturasGlobais = [];

    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("formSegundaViaModal");
        const selectMes = document.getElementById("selectMes");

        if (form) {
            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                const cpfCnpjInput = document.getElementById("cpfCnpjModalInput");
                const cpfCnpj = cpfCnpjInput ? cpfCnpjInput.value.trim() : "";
                const containerResultado = document.getElementById("resultadoFaturasModal");
                const loading = document.getElementById("loadingModal");
                const btnBuscar = document.getElementById("btnBuscarModal");
                const filtroContainer = document.getElementById("filtroMesContainer");

                if (!cpfCnpj) return;

                if (containerResultado) containerResultado.innerHTML = "";
                if (filtroContainer) filtroContainer.style.display = "none";
                if (loading) loading.style.display = "flex";
                if (btnBuscar) btnBuscar.disabled = true;

                try {
                    const response = await fetch("/api/segunda-via.php", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ cpf_cnpj: cpfCnpj }),
                    });

                    const rawText = await response.text();
                    let data;
                    try {
                        data = JSON.parse(rawText);
                    } catch (jsonErr) {
                        throw new Error(rawText.length > 0 ? `Resposta do servidor: ${rawText.substring(0, 180)}` : "O servidor não retornou dados.");
                    }

                    if (loading) loading.style.display = "none";
                    if (btnBuscar) btnBuscar.disabled = false;

                    if (data.sucesso && data.faturas && data.faturas.length > 0) {
                        faturasGlobais = data.faturas;
                        const mesPadrao = popularFiltroMes(faturasGlobais);
                        if (filtroContainer) filtroContainer.style.display = "block";

                        // Filtra e exibe inicialmente o mês atual (ou todos se o mês atual não tiver fatura)
                        if (mesPadrao !== "todos") {
                            const filtradas = faturasGlobais.filter(f => f.vencimento.startsWith(mesPadrao));
                            renderizarFaturas(filtradas);
                        } else {
                            renderizarFaturas(faturasGlobais);
                        }
                    } else {
                        if (containerResultado) containerResultado.innerHTML = `<p class="erro-msg">${data.mensagem || "Nenhuma fatura localizada."}</p>`;
                    }
                } catch (error) {
                    if (loading) loading.style.display = "none";
                    if (btnBuscar) btnBuscar.disabled = false;
                    if (containerResultado) {
                        containerResultado.innerHTML = `<p class="erro-msg">${error.message}</p>`;
                    }
                }
            });
        }

        if (selectMes) {
            selectMes.addEventListener("change", (e) => {
                const mesSelecionado = e.target.value;
                if (mesSelecionado === "todos") {
                    renderizarFaturas(faturasGlobais);
                } else {
                    const filtradas = faturasGlobais.filter(f => f.vencimento.startsWith(mesSelecionado));
                    renderizarFaturas(filtradas);
                }
            });
        }
    });

    function formatarDataBR(dataStr) {
        if (!dataStr) return "";
        const partes = dataStr.split("-");
        if (partes.length === 3) {
            return `${partes[2]}/${partes[1]}/${partes[0]}`;
        }
        return dataStr;
    }

    function popularFiltroMes(faturas) {
        const selectMes = document.getElementById("selectMes");
        if (!selectMes) return;

        selectMes.innerHTML = '<option value="todos">Todas as faturas em aberto</option>';

        const mesesUnicos = [...new Set(faturas.map(f => f.vencimento.substring(0, 7)))];

        mesesUnicos.forEach(anoMes => {
            const [ano, mes] = anoMes.split("-");
            const nomeMeses = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
            const labelFormatado = `${nomeMeses[parseInt(mes, 10) - 1]} de ${ano}`;
            
            const option = document.createElement("option");
            option.value = anoMes;
            option.textContent = labelFormatado;
            selectMes.appendChild(option);
        });

        // Descobre o mês e ano atual (YYYY-MM)
        const agora = new Date();
        const anoAtual = agora.getFullYear();
        const mesAtual = String(agora.getMonth() + 1).padStart(2, '0');
        const mesAtualStr = `${anoAtual}-${mesAtual}`;

        // Se houver fatura para o mês atual, seleciona ele automaticamente
        if (mesesUnicos.includes(mesAtualStr)) {
            selectMes.value = mesAtualStr;
            return mesAtualStr;
        }

        return "todos";
    }

    function renderizarFaturas(faturas) {
        const containerResultado = document.getElementById("resultadoFaturasModal");
        if (!containerResultado) return;

        if (faturas.length === 0) {
            containerResultado.innerHTML = `<p class="erro-msg">Nenhuma fatura encontrada para este mês.</p>`;
            return;
        }

        let html = '<div class="faturas-grid">';
        faturas.forEach((fatura, index) => {
            let badgeClass = "badge-atual";
            let statusText = fatura.periodo;
            if (fatura.periodo === "Em Atraso") {
                badgeClass = "badge-atraso";
                statusText = "⚠ Vencida / Em Atraso";
            } else {
                badgeClass = "badge-atual";
                statusText = "✓ A Vencer";
            }

            const vencimentoFormatado = formatarDataBR(fatura.vencimento);

            const urlQrCode = fatura.pix_copia_cola
                ? `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(fatura.pix_copia_cola)}`
                : "";

            html += `
                <div class="fatura-card">
                    <div class="card-top-bar">
                        <span class="badge ${badgeClass}">${statusText}</span>
                        <span class="fatura-id">Vencimento: <strong>${vencimentoFormatado}</strong></span>
                    </div>

                    <div class="card-valor-section">
                        <span class="valor-label">Valor Total</span>
                        <span class="fatura-valor">R$ ${fatura.valor}</span>
                    </div>

                    ${
                        fatura.pix_copia_cola
                            ? `
                      <div class="pagamento-secao pix-secao">
                        <div class="secao-titulo">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                          Pagamento Instantâneo via PIX
                        </div>
                        <div class="pix-content-grid">
                          <div class="qr-wrapper">
                            <img src="${urlQrCode}" alt="QR Code PIX" class="qr-code-img">
                          </div>
                          <div class="pix-info-side">
                            <p class="instrucao-pix">Escaneie o QR Code com o app do seu banco ou copie a chave abaixo:</p>
                            <div class="codigo-box" id="pixCode_${index}">${fatura.pix_copia_cola}</div>
                            <button type="button" class="btn-acao btn-pix" onclick="copiarTexto('pixCode_${index}', this)">
                              📋 Copiar Chave Pix Copia e Cola
                            </button>
                          </div>
                        </div>
                      </div>
                    `
                            : ""
                    }

                    ${
                        fatura.linha_digitavel
                            ? `
                      <div class="pagamento-secao linha-secao">
                        <div class="secao-titulo">Código de Barras / Linha Digitável</div>
                        <div class="codigo-box" id="linhaCode_${index}">${fatura.linha_digitavel}</div>
                        <button type="button" class="btn-acao btn-linha" onclick="copiarTexto('linhaCode_${index}', this)">
                          📋 Copiar Linha Digitável
                        </button>
                      </div>
                    `
                            : ""
                    }

                    <div class="card-actions-footer">
                      <a href="${fatura.link_pdf}" target="_blank" class="btn-acao btn-pdf">
                        📄 Baixar / Imprimir Boleto em PDF
                      </a>
                    </div>
                </div>
            `;
        });

        html += "</div>";
        containerResultado.innerHTML = html;
    }

    window.copiarTexto = function(elementId, btnElement) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const texto = el.innerText;
        navigator.clipboard.writeText(texto).then(() => {
            const textoOriginal = btnElement.innerText;
            btnElement.innerText = "✅ Copiado!";
            btnElement.style.opacity = "0.8";
            setTimeout(() => {
                btnElement.innerText = textoOriginal;
                btnElement.style.opacity = "1";
            }, 2000);
        });
    };
</script>

<style is:global>
    .segunda-via-page {
        position: relative;
        min-height: 100vh;
        padding: 140px 20px 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: var(--color-gray-light, #f5f5f5);
        overflow: hidden;
        box-sizing: border-box;
    }

    .blob {
        position: absolute;
        filter: blur(100px);
        z-index: 0;
        opacity: 0.35;
        pointer-events: none;
    }
    .blob-purple {
        top: -10%;
        right: 10%;
        width: 450px;
        height: 450px;
        background: rgba(0, 15, 118, 0.3);
        border-radius: 50%;
    }
    .blob-blue {
        top: 15%;
        left: 5%;
        width: 550px;
        height: 550px;
        background: rgba(3, 37, 208, 0.25);
        border-radius: 50%;
    }

    .container-hero {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 720px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .hero-header h1 {
        font-size: clamp(2rem, 4vw, var(--fs-h1));
        color: var(--color-gray-dark);
        margin-bottom: var(--space-8);
        line-height: 1.2;
    }

    .hero-header h1 strong {
        color: var(--color-primary);
    }

    .hero-header p {
        color: var(--color-gray-medium);
        font-size: var(--fs-body);
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.5;
    }

    .search-box-wrapper {
        width: 100%;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(3, 37, 208, 0.12);
        padding: 6px;
        border-radius: var(--radius-full, 9999px);
        box-shadow: var(--elevation-2, 0 20px 25px -5px rgba(0, 0, 0, 0.05));
        box-sizing: border-box;
    }

    .search-pill-form {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .input-icon-group {
        display: flex;
        align-items: center;
        flex: 1;
        padding-left: 20px;
        gap: 12px;
    }

    .search-icon {
        color: var(--color-gray-low, #a3a3a3);
        flex-shrink: 0;
    }

    .search-pill-form input[type="text"] {
        width: 100%;
        border: none;
        background: transparent;
        font-size: 1.05rem;
        color: var(--color-gray-dark, #141414);
        outline: none;
    }

    .search-pill-form input[type="text"]::placeholder {
        color: var(--color-gray-low, #a3a3a3);
    }

    .btn-search-pill {
        background: var(--gradient-brand);
        color: var(--color-white);
        border: none;
        padding: 14px 32px;
        border-radius: var(--radius-full);
        font-weight: 600;
        font-size: var(--fs-sm);
        cursor: pointer;
        transition: all 0.2s var(--ease-brand, ease);
        flex-shrink: 0;
    }

    .btn-search-pill:hover {
        filter: brightness(1.08);
    }

    .filtro-wrapper {
        background: var(--color-white);
        border: 1px solid var(--color-gray-light);
        padding: var(--space-12) var(--space-16);
        border-radius: var(--radius-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        box-shadow: var(--elevation-1);
    }

    .filtro-label {
        font-size: var(--fs-caption);
        font-weight: 600;
        color: var(--color-gray-medium);
    }

    .filtro-select {
        width: 100%;
        padding: var(--space-8) var(--space-12);
        border: 1px solid var(--color-gray-low);
        border-radius: var(--radius-md);
        background-color: var(--color-gray-light);
        font-size: var(--fs-sm);
        color: var(--color-gray-dark);
        outline: none;
        cursor: pointer;
    }

    .loading-state {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 35px;
        color: var(--color-primary, #0325d0);
        font-weight: 600;
    }

    .spinner {
        width: 22px;
        height: 22px;
        border: 3px solid rgba(3, 37, 208, 0.15);
        border-top-color: var(--color-primary, #0325d0);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .resultado-container {
        width: 100%;
        margin-top: 20px;
    }

    .faturas-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
    }

    .fatura-card {
        position: relative;
        background: var(--color-white);
        border: 1px solid var(--color-gray-light);
        border-radius: var(--radius-signature-sm);
        padding: var(--space-24);
        box-shadow: var(--elevation-1, 0 10px 30px -5px rgba(0, 0, 0, 0.04));
        box-sizing: border-box;
        text-align: left;
        overflow: hidden;
    }

    .fatura-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gradient-brand);
    }

    .card-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--color-gray-light, #f1f5f9);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-4) var(--space-12);
        border-radius: var(--radius-full);
        font-size: var(--fs-caption);
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    .badge-atraso { background-color: var(--color-danger-bg); color: var(--color-danger); }
    .badge-atual { background-color: rgba(3, 37, 208, 0.1); color: var(--color-primary); }

    .fatura-id {
        font-size: var(--fs-sm);
        color: var(--color-gray-medium);
    }

    .card-valor-section {
        margin-bottom: 24px;
    }

    .valor-label {
        display: block;
        font-size: var(--fs-caption);
        font-weight: 600;
        text-transform: uppercase;
        color: var(--color-gray-low);
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }

    .fatura-valor {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--color-gray-dark, #141414);
        letter-spacing: -0.02em;
    }

    .pagamento-secao {
        background: var(--color-gray-light);
        border: 1px solid var(--color-gray-light);
        border-radius: var(--radius-lg);
        padding: var(--space-16);
        margin-bottom: var(--space-16);
    }

    .pix-secao {
        background: var(--color-success-bg);
        border-color: var(--color-success-border);
    }

    .secao-titulo {
        display: flex;
        align-items: center;
        gap: var(--space-8);
        font-weight: 700;
        font-size: var(--fs-caption);
        color: var(--color-success);
        margin-bottom: var(--space-12);
    }

    .linha-secao .secao-titulo {
        color: var(--color-dark-blue);
    }

    .pix-content-grid {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .qr-wrapper {
        background: var(--color-white);
        padding: var(--space-8);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-success-border);
        flex-shrink: 0;
    }

    .qr-code-img {
        width: 130px;
        height: 130px;
        display: block;
        border-radius: var(--radius-sm);
    }

    .pix-info-side {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    .instrucao-pix {
        font-size: var(--fs-caption);
        color: var(--color-success);
        margin: 0;
        line-height: 1.4;
    }

    .codigo-box {
        background: var(--color-white);
        padding: var(--space-8) var(--space-12);
        font-family: monospace;
        font-size: var(--fs-caption);
        word-break: break-all;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-gray-low);
        color: var(--color-gray-dark);
        max-height: 70px;
        overflow-y: auto;
    }

    .pix-secao .codigo-box {
        border-color: var(--color-success-border);
    }

    .btn-acao {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-8);
        width: 100%;
        text-align: center;
        padding: var(--space-12);
        border: none;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: var(--fs-caption);
        cursor: pointer;
        text-decoration: none;
        transition: var(--transition-default);
    }

    .btn-pix {
        background: var(--color-success);
        color: var(--color-white);
    }
    .btn-pix:hover { filter: brightness(0.9); }

    .btn-linha {
        background: var(--color-dark-blue);
        color: var(--color-white);
        margin-top: var(--space-8);
    }
    .btn-linha:hover { background: var(--color-primary); }

    .card-actions-footer {
        margin-top: var(--space-24);
    }

    .btn-pdf {
        background: var(--gradient-brand);
        color: var(--color-white);
        font-size: var(--fs-sm);
        padding: var(--space-16);
    }
    .btn-pdf:hover {
        filter: brightness(1.08);
    }

    .erro-msg {
        color: var(--color-danger);
        text-align: center;
        font-weight: 600;
        margin-top: var(--space-24);
        background: var(--color-danger-bg);
        padding: var(--space-16);
        border-radius: var(--radius-lg);
        border: 1px solid var(--color-danger-border);
    }

    @media (max-width: 640px) {
        .search-pill-form {
            flex-direction: column;
            background: transparent;
            backdrop-filter: none;
            box-shadow: none;
            border: none;
            padding: 0;
            gap: 10px;
        }

        .search-box-wrapper {
            background: rgba(255, 255, 255, 0.95);
            padding: 10px;
            border-radius: var(--radius-lg);
        }

        .input-icon-group {
            padding-left: 0;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--color-gray-light);
        }

        .btn-search-pill {
            width: 100%;
            padding: 14px;
        }

        .pix-content-grid {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .card-top-bar {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }
    }
</style>