---
import Layout from "../layouts/Layout.astro";
import CardPlano from "../components/CardPlano.astro";
import "../styles/global.css";

// Adicionais padrão para planos residenciais simples
const adicionaisResidencial = [
    { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 39.90 },
    { nome: "Câmera Inteligente", preco: 39.90 },
    { nome: "Linha Telefônica Fixa", preco: 29.90 }
];
---

<Layout title="Planos Residenciais - Zamtech Fibra Óptica">
    <!-- 1. HERO SECTION RESIDENCIAL -->
    <section class="hero-residencia">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <span class="badge-hero">
                <img src="/assets/icons/others-icons/casa-house-white.svg" alt="Casa" width="18" height="18" />
                Zamtech para Residência
            </span>
            <h1>Tenha uma conexão rápida, estável e preparada para tudo que acontece dentro da sua casa</h1>
            <p>
                Seja para assistir filmes em 4K sem travar, trabalhar em home office, estudar ou jogar online, a Zamtech entrega a fibra óptica que a sua família merece.
            </p>
            <a href="#planos" class="btn btn-yellow btn-hero">
                Começar
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <polyline points="19 12 12 19 5 12"></polyline>
                </svg>
            </a>
        </div>
    </section>

    <!-- 2. SEÇÃO DE PLANOS COM SWITCH -->
    <section id="planos" class="section section-planos">
        <div class="container">
            <div class="header-planos">
                <span class="subtitulo-tag">Escolha a Velocidade Ideal</span>
                <h2 class="titulo-secao-local">Conheça nossos Planos Residenciais</h2>
                <p class="desc-secao">
                    Selecione abaixo a categoria de plano que melhor se adapta à rotina e ao tamanho da sua casa.
                </p>

                <!-- SWITCH / CHAVE DE ALTERNÂNCIA -->
                <div class="switch-container">
                    <button id="btn-entrada" class="switch-btn">
                        Planos de Entrada
                    </button>
                    <button id="btn-melhores" class="switch-btn active">
                        Melhores Planos (Combos)
                        <span class="badge-pop">Mais Escolhidos</span>
                    </button>
                </div>
            </div>

            <!-- GRID 1: MELHORES PLANOS (PADRÃO VISÍVEL) -->
            <div id="grid-melhores" class="plans-grid">
                <!-- ZAMTECH 800 + MESH (ULTRA MESH) -->
                <CardPlano
                    nome="ZAMTECH 800 - Ultra Mesh"
                    velocidade="800 Mega + Wi-Fi na Casa Toda"
                    precoBase={129.90}
                    badge="RECOMENDADO PARA CASAS MAIORES"
                    imagemFundo="/assets/img/duas-raparigas-no-computador-a-noite_169016-60376.jpg"
                    isFeatured={true}
                    recursos={[
                        "1 Ponto Extra Wi-Fi Mesh Incluso",
                        "Zero pontos cegos ou sinal caindo",
                        "Instalação e Suporte Técnico inclusos"
                    ]}
                    adicionais={[
                        { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 0, incluso: true },
                        { nome: "Câmera Inteligente", preco: 39.90 },
                        { nome: "Linha Telefônica Fixa", preco: 29.90 }
                    ]}
                />

                <!-- ZAMTECH 800 + CÂMERA (ULTRA SECURE) -->
                <CardPlano
                    nome="ZAMTECH 800 - Ultra Secure"
                    velocidade="800 Mega + Câmera em Nuvem"
                    precoBase={139.90}
                    badge="COMBO SEGURANÇA RESIDENCIAL"
                    imagemFundo="/assets/img/sorridente-menina-sentada-no-sofa-e-usando-laptop-na-sala-de-estar_637285-3969.jpg"
                    posicaoFundo="top"
                    recursos={[
                        "1 Câmera de Monitoramento em comodato",
                        "Gravação de vídeo 100% salva na nuvem",
                        "Acesso ao vivo pelo App Zamtech"
                    ]}
                    adicionais={[
                        { nome: "Câmera Inteligente", preco: 0, incluso: true },
                        { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 39.90 },
                        { nome: "Linha Telefônica Fixa", preco: 29.90 }
                    ]}
                />

                <!-- PLANO GAMER 1G -->
                <CardPlano
                    nome="PLANO GAMER 1G"
                    velocidade="1 Giga + Wi-Fi 6 Especial"
                    precoBase={179.90}
                    badge="PERFORMANCE MÁXIMA"
                    imagemFundo="/assets/img/jogador-profissional-de-esports-se-alegra-com-a-vitoria_191095-2016.jpg"
                    isFeatured={true}
                    recursos={[
                        "Roteador com tecnologia Wi-Fi 6",
                        "IP Público Incluso para servidores e jogos",
                        "Baixíssima latência para partidas sem lag"
                    ]}
                    adicionais={[
                        { nome: "Mais Pontos de Wi-Fi (Mesh)", preco: 39.90 },
                        { nome: "Câmera Inteligente", preco: 39.90 },
                        { nome: "Linha Telefônica Fixa", preco: 29.90 }
                    ]}
                />
            </div>

            <!-- GRID 2: PLANOS DE ENTRADA (OCULTO INICIALMENTE) -->
            <div id="grid-entrada" class="plans-grid hidden">
                <!-- ZAMTECH 300 - PLAY -->
                <CardPlano
                    nome="ZAMTECH 300 - Play"
                    velocidade="300 Mega"
                    precoBase={79.90}
                    imagemFundo="/assets/img/casal-de-vista-frontal-jogando-videogame_23-2150573866.jpg"
                    recursos={[
                        "Ideal para até 5 aparelhos conectados",
                        "Suporte rápido e humanizado"
                    ]}
                    adicionais={adicionaisResidencial}
                />

                <!-- ZAMTECH 500 - STREAM -->
                <CardPlano
                    nome="ZAMTECH 500 - Stream"
                    velocidade="500 Mega"
                    precoBase={89.90}
                    badge="MAIS POPULAR DA CATEGORIA"
                    imagemFundo="/assets/img/grupo-de-amigos-se-divertindo-jogando-videogame-juntos-em-casa-conceito-de-amigos_58466-16326.jpg"
                    isFeatured={true}
                    recursos={[
                        "Excelente para Smart TVs em 4K",
                        "Ideal para até 10 aparelhos conectados"
                    ]}
                    adicionais={adicionaisResidencial}
                />

                <!-- ZAMTECH 800 - ULTRA -->
                <CardPlano
                    nome="ZAMTECH 800 - Ultra"
                    velocidade="800 Mega"
                    precoBase={99.90}
                    imagemFundo="/assets/img/homem-de-tiro-medio-jogando-videogame_23-2150573864.jpg"
                    recursos={[
                        "Conecta mais de 15 aparelhos sem perda",
                        "Download ultrarrápido de arquivos pesados"
                    ]}
                    adicionais={adicionaisResidencial}
                />
            </div>
        </div>
    </section>

    <!-- 3. SEÇÃO EDUCATIVA: COMO POTENCIALIZAR SUA INTERNET -->
    <section class="section section-potencializar">
        <div class="container">
            <div class="potencializar-header">
                <span class="subtitulo-tag-blue">Entenda o que você está contratando</span>
                <h2>Como potencializar a internet na sua casa?</h2>
                <p>Nós não usamos termos difíceis. Aqui você entende exatamente o benefício de cada tecnologia no seu dia a dia.</p>
            </div>

            <div class="potencializar-grid">
                <!-- CARD MESH -->
                <div class="potencializar-card">
                    <div class="card-img-wrapper">
                        <img 
                            src="/assets/equipamentos/roteador-wifi-mesh.webp" 
                            alt="Roteador Wi-Fi Mesh" 
                            loading="lazy"
                        />
                    </div>
                    <div class="card-text">
                        <div class="card-tag">Pontos de Wi-Fi Extra</div>
                        <h3>O que é a Tecnologia Mesh?</h3>
                        <p>Sabe quando o Wi-Fi funciona muito bem na sala, mas fica fraco no quarto ou no quintal?</p>
                        <p>A tecnologia Mesh são <strong>pontos de internet espalhados pela casa</strong> que conversam entre si e criam uma teia única de sinal forte. Você anda pela casa inteira assistindo seus vídeos sem que a internet caia ou fique lenta!</p>
                        <ul class="mini-benefits">
                            <li>Elimina pontos cegos sem sinal</li>
                            <li>Sinal forte em todos os cômodos</li>
                            <li>Você não precisa ficar trocando de rede</li>
                        </ul>
                    </div>
                </div>

                <!-- CARD CÂMERA -->
                <div class="potencializar-card">
                    <div class="card-img-wrapper">
                        <img 
                            src="/assets/equipamentos/camera-monitoramento.webp" 
                            alt="Câmera de Monitoramento Inteligente" 
                            loading="lazy"
                        />
                    </div>
                    <div class="card-text">
                        <div class="card-tag">Segurança em Nuvem</div>
                        <h3>O que é a Câmera Inteligente?</h3>
                        <p>
                            É um sistema moderno de monitoramento para proteger sua família sem complicações técnicas.
                        </p>
                        <p>
                            <strong>Não precisa comprar aparelhos gravadores (DVR) nem HDs caros.</strong> Todas as imagens ficam salvas na nuvem com segurança e você acompanha tudo ao vivo pelo aplicativo no seu celular de onde estiver.
                        </p>
                        <ul class="mini-benefits">
                            <li>Acesso ao vivo pelo celular</li>
                            <li>Gravações salvas 100% na nuvem</li>
                            <li>Zero necessidade de aparelhos no rack</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. CHAMADA FINAL PARA SUPORTE/DUVIDAS -->
    <section class="section section-cta">
        <div class="container cta-box">
            <h2>Ainda em dúvida sobre qual plano escolher?</h2>
            <p>
                Nossa equipe de especialistas te ajuda a entender quantos Mega a sua casa realmente precisa, sem empurrar serviços desnecessários.
            </p>
            <a href="https://wa.me/5527995057736?text=Ol%C3%A1%21%20Gostaria%20de%20falar%20com%20um%20consultor%20corporativo." class="btn btn-yellow" target="_blank">
                Falar com um Atendente
            </a>
        </div>
    </section>
</Layout>

<!-- JAVASCRIPT DE ALTERNÂNCIA DOS PLANOS -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const btnEntrada = document.getElementById("btn-entrada");
        const btnMelhores = document.getElementById("btn-melhores");
        const gridEntrada = document.getElementById("grid-entrada");
        const gridMelhores = document.getElementById("grid-melhores");

        if (btnEntrada && btnMelhores && gridEntrada && gridMelhores) {
            btnEntrada.addEventListener("click", () => {
                btnEntrada.classList.add("active");
                btnMelhores.classList.remove("active");
                gridEntrada.classList.remove("hidden");
                gridMelhores.classList.add("hidden");
            });

            btnMelhores.addEventListener("click", () => {
                btnMelhores.classList.add("active");
                btnEntrada.classList.remove("active");
                gridMelhores.classList.remove("hidden");
                gridEntrada.classList.add("hidden");
            });
        }
    });
</script>

<style>
    /* 1. HERO SECTION RESIDENCIAL */
    .hero-residencia {
        position: relative;
        padding: var(--space-64) 0;
        background-image: url('/assets/img/backgrounds/wallpaper-planos-residenciais.webp');
        background-size: cover;
        background-position: center 30%;
        color: var(--color-white);
        min-height: 700px;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: left;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: #000000a9;
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 800px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: left;
        gap: var(--space-16);
    }

    .badge-hero {
        display: inline-flex;
        align-items: center;
        gap: var(--space-8);
        padding: 6px 16px;
        background-color: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: var(--radius-full);
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--color-white);
    }

    .hero-content h1 {
        font-size: clamp(2rem, 4vw, var(--fs-h1));
        line-height: 1.15;
    }

    .hero-content p {
        font-size: var(--fs-body);
        color: var(--color-gray-low);
        line-height: 1.6;
        max-width: 680px;
    }

    .btn-hero {
        margin-top: var(--space-12);
        gap: var(--space-8);
    }

    .btn-yellow {
        background-color: var(--color-secondary);
        color: var(--color-white);
        font-weight: 700;
    }

    .btn-yellow:hover {
        background-color: var(--color-primary);
    }

    /* 2. SEÇÃO DE PLANOS & SWITCH */
    .section-planos {
        background-color: var(--color-white);
    }

    .header-planos {
        text-align: center;
        max-width: 700px;
        margin: 0 auto var(--space-48);
    }

    .subtitulo-tag {
        font-size: var(--fs-caption);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-primary);
        letter-spacing: 1px;
    }

    .titulo-secao-local {
        font-size: var(--fs-h2);
        color: var(--color-dark-blue);
        margin: var(--space-4) 0 var(--space-12);
    }

    .desc-secao {
        color: var(--color-gray-medium);
        font-size: var(--fs-body);
    }

    /* Estilos da Chave de Alternância (Switch) */
    .switch-container {
        display: inline-flex;
        background-color: var(--color-gray-light);
        padding: 6px;
        border-radius: var(--radius-full);
        gap: var(--space-8);
        margin-top: var(--space-24);
        border: 1px solid var(--color-border);
    }

    .switch-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-8);
        padding: 12px 24px;
        border-radius: var(--radius-full);
        font-size: var(--fs-sm);
        font-weight: 700;
        color: var(--color-gray-medium);
        transition: var(--transition-default);
        cursor: pointer;
    }

    .switch-btn.active {
        background: var(--gradient-brand);
        color: var(--color-white);
        box-shadow: var(--elevation-2);
    }

    .badge-pop {
        background-color: var(--color-yellow);
        color: var(--color-black);
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: var(--radius-full);
        font-weight: 800;
    }

    /* Grids de Planos */
    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: var(--space-32);
    }

    .plans-grid.hidden {
        display: none !important;
    }

    /* 3. SEÇÃO EDUCATIVA (COMO POTENCIALIZAR) */
    .section-potencializar {
        background-color: var(--color-gray-light);
    }

    .potencializar-header {
        text-align: center;
        max-width: 700px;
        margin: 0 auto var(--space-48);
    }

    .subtitulo-tag-blue {
        font-size: var(--fs-caption);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-secondary);
        letter-spacing: 1px;
    }

    .potencializar-header h2 {
        font-size: var(--fs-h2);
        color: var(--color-dark-blue);
        margin: var(--space-4) 0 var(--space-12);
    }

    .potencializar-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-32);
    }

    @media (min-width: 850px) {
        .potencializar-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .potencializar-card {
        background-color: var(--color-white);
        border-radius: var(--radius-lg);
        padding: var(--space-32);
        box-shadow: var(--elevation-1);
        display: flex;
        flex-direction: column;
        gap: var(--space-20);
        border: 1px solid var(--color-border);
    }

    .card-img-wrapper {
        width: 100%;
        height: 220px;
        border-radius: var(--radius-md);
        overflow: hidden;
        background-color: var(--color-gray-light);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-img-wrapper img {
        max-height: 100%;
        object-fit: contain;
    }

    .card-tag {
        display: inline-block;
        padding: 4px 12px;
        background-color: rgba(3, 37, 208, 0.08);
        color: var(--color-primary);
        font-size: var(--fs-caption);
        font-weight: 700;
        border-radius: var(--radius-full);
        margin-bottom: var(--space-8);
    }

    .card-text h3 {
        font-size: var(--fs-h4);
        color: var(--color-dark-blue);
        margin-bottom: var(--space-12);
    }

    .card-text p {
        font-size: var(--fs-sm);
        color: var(--color-gray-medium);
        line-height: 1.6;
        margin-bottom: var(--space-12);
    }

    .mini-benefits {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        margin-top: var(--space-16);
        padding-top: var(--space-16);
        border-top: 1px solid var(--color-border);
    }

    .mini-benefits li {
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--color-dark-blue);
        display: flex;
        align-items: center;
        gap: var(--space-8);
    }

    .mini-benefits li::before {
        content: "✓";
        color: var(--color-secondary);
        font-weight: 900;
    }

    /* 4. CHAMADA FINAL (CTA) */
    .section-cta {
        background-color: var(--color-dark-blue);
        color: var(--color-white);
        text-align: center;
    }

    .cta-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-16);
        max-width: 700px;
    }

    .cta-box h2 {
        font-size: var(--fs-h2);
    }

    .cta-box p {
        color: var(--color-gray-low);
    }
</style>