---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import ConsentimentoLGPD from '../components/ConsentimentoLGPD.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';

const { title = "Zamtech - Fibra Óptica" } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="shortcut icon" href="/assets/icons/website-global-icons/icon-zamtech.svg" type="image/x-icon">
    <link rel="apple-touch-icon" href="/assets/icons/website-global-icons/icon-zamtech.svg">
</head>
<body class="margin-compensa">
    <Header />
    <slot />
    <Footer />
    <ConsentimentoLGPD />
    <BotaoWhatsApp />
</body>
<style>
    .margin-compensa {
        padding-top: 60px;
    }
</style>
</html>