---
// CardPlano.astro
interface Adicional {
    nome: string;
    preco: number;
    incluso?: boolean;
}

interface Props {
    nome: string;
    velocidade?: string;
    precoBase: number;
    // Opcional de propósito: texto de descrição solto tende a virar
    // "linguiça" (frase genérica só pra preencher espaço). O card já mostra
    // o que importa via badge + recursos (lista real de itens) + adicionais
    // — descricao só deve ser usada quando tem informação de verdade que
    // não cabe em nenhum outro lugar do card.
    descricao?: string;
    badge?: string;
    economia?: string;
    recursos?: string[];
    adicionais?: Adicional[];
    isFeatured?: boolean;
    // Foto de fundo do banner no topo do card (não o card inteiro — só a
    // faixa de cima, estilo cartão de plano com foto + preço "recortando"
    // a imagem). Se a página não passar nenhuma, usa uma imagem genérica
    // de fibra/conexão como fallback.
    imagemFundo?: string;
    // Posição do foco da foto (equivale a CSS background-position). Usado
    // quando a imagem é vertical/retrato e o "center" padrão acaba
    // cortando cabeça ou rosto na faixa baixa e larga do card — nesses
    // casos passa "center top" (ou similar) pra puxar o corte pra baixo
    // em vez de cortar de cima.
    posicaoFundo?: string;
    // "whatsapp" (padrão, usado em /planos-residenciais e /planos-empresariais):
    // botão manda direto pro WhatsApp com o plano + adicionais escolhidos.
    // "selecionar" (usado em /contratar): botão não manda pra lugar nenhum
    // sozinho — dispara o evento "zamtech:plano-selecionado" com o plano já
    // calculado (nome, preço final, adicionais), pra quem importou o card
    // decidir o que fazer (ex: avançar pra etapa de pré-cadastro).
    modo?: "whatsapp" | "selecionar";
}

const {
    nome,
    velocidade,
    precoBase,
    descricao,
    badge,
    economia,
    recursos = [],
    adicionais = [],
    isFeatured = false,
    imagemFundo = "/assets/img/backgrounds/background-internet-zamtech.webp",
    posicaoFundo = "center",
    modo = "whatsapp",
} = Astro.props;

// Formata preço inicial
const [inteiroInicial, centavosIniciais] = precoBase.toFixed(2).split(".");
---

<article
    class={`card-plano-dinamico ${isFeatured ? "card-plano--featured" : ""}`}
    data-preco-base={precoBase}
    data-nome-plano={nome}
    data-velocidade={velocidade}
    data-modo={modo}
>
    {
        badge && (
            <div class="card-badge">
                <svg viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                </svg>
                {badge}
            </div>
        )
    }

    <!-- FAIXA COM FOTO NO TOPO — só essa parte do card tem imagem, o resto
         do corpo continua claro (branco), com a "onda" fazendo a costura
         entre as duas partes, igual à referência que você mandou. -->
    <div
        class="hero-banner"
        style={`background-image: linear-gradient(to right, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.25) 45%, rgba(0, 0, 0, 0) 100%), url("${imagemFundo}"); background-position: ${posicaoFundo};`}
    >
        <span class="hero-subtitle">{nome}</span>
        {velocidade && <h3 class="hero-title">{velocidade}</h3>}
        {economia && <span class="hero-tag">{economia}</span>}

        <svg class="curve-divider" viewBox="0 0 360 65" preserveAspectRatio="none">
            <path d="M 0 35 C 40 35, 45 60, 85 60 C 130 60, 140 0, 185 0 L 360 0 L 360 65 L 0 65 Z" />
        </svg>

        <div class="price-box">
            <div class="price-main">
                <span class="currency">R$</span>
                <span class="val-inteiro">{inteiroInicial}</span>
                <div class="price-fraction">
                    <span class="val-centavos">,{centavosIniciais}</span>
                    <span class="period">/mês</span>
                </div>
            </div>
        </div>
    </div>

    <!-- CORPO CLARO DO CARD -->
    <div class="card-body">
        <!-- BOTÃO DE AÇÃO -->
        {
            modo === "whatsapp" ? (
                <a href="#" class="btn btn-primary btn-whatsapp">
                    Adquirir Plano
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            ) : (
                <button type="button" class="btn btn-primary btn-selecionar-plano">
                    Escolher este plano
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>
            )
        }

        <!-- RECURSOS DO PLANO -->
        {
            recursos.length > 0 && (
                <ul class="resources-list">
                    {recursos.map((rec) => (
                        <li>
                            <img src="/assets/icons/check-zamtech.svg" alt="Check" />
                            <span>{rec}</span>
                        </li>
                    ))}
                </ul>
            )
        }

        <!-- LISTA DE OPCIONAIS / ADICIONAIS -->
        {
            adicionais.length > 0 && (
                <div class="adicionais-container">
                    <span class="adicionais-title">Turbine seu plano:</span>
                    {adicionais.map((item) => (
                        <div class="adicional-item">
                            {/* Sem repetir o preço aqui: o switch já mostra o
                                que está ligado/desligado, e o preço lá em cima
                                do card já atualiza sozinho ao marcar/desmarcar —
                                escrever "+ R$ X" de novo em cada linha só
                                duplicava informação que o próprio card já dá. */}
                            <span class="adicional-label">{item.nome}</span>
                            <label class="switch">
                                <input
                                    type="checkbox"
                                    class="chk-adicional"
                                    data-preco={item.preco}
                                    data-nome={item.nome}
                                    checked={item.incluso}
                                    disabled={item.incluso}
                                />
                                <span class="slider" />
                            </label>
                        </div>
                    ))}
                </div>
            )
        }

        {descricao && <p class="description-text">{descricao}</p>}
    </div>
</article>

<script>
    function initCalculadoraPlanos() {
        const cards = document.querySelectorAll(".card-plano-dinamico");
        const whatsappPhone = "5527995057736";

        cards.forEach((card) => {
            const basePrice = parseFloat(
                card.getAttribute("data-preco-base") || "0",
            );
            const planName =
                card.getAttribute("data-nome-plano") || "Plano Zamtech";
            const velocidade = card.getAttribute("data-velocidade") || "";
            const modo = card.getAttribute("data-modo") || "whatsapp";

            const valInteiro = card.querySelector(".val-inteiro");
            const valCentavos = card.querySelector(".val-centavos");
            const btnZap = card.querySelector(
                ".btn-whatsapp",
            ) as HTMLAnchorElement | null;
            const btnSelecionar = card.querySelector(
                ".btn-selecionar-plano",
            ) as HTMLButtonElement | null;
            const checkboxes = card.querySelectorAll(
                ".chk-adicional",
            ) as NodeListOf<HTMLInputElement>;

            let precoFinalAtual = basePrice;
            let selecionadosAtual: string[] = [];

            function calcular() {
                let precoAtual = basePrice;
                let selecionados: string[] = [];

                checkboxes.forEach((chk) => {
                    // Só soma se estiver marcado e NÃO for um item promocional já travado/incluso no preço base
                    if (chk.checked && !chk.disabled) {
                        const preco = parseFloat(
                            chk.getAttribute("data-preco") || "0",
                        );
                        const nome = chk.getAttribute("data-nome") || "";
                        precoAtual += preco;
                        if (preco > 0) selecionados.push(nome);
                    }
                });

                const [inteiro, centavos] = precoAtual.toFixed(2).split(".");
                if (valInteiro) valInteiro.textContent = inteiro;
                if (valCentavos) valCentavos.textContent = `,${centavos}`;

                precoFinalAtual = precoAtual;
                selecionadosAtual = selecionados;

                if (modo === "whatsapp" && btnZap) {
                    // Monta mensagem do WhatsApp
                    let msg = `Olá! Quero contratar o plano ${planName} (R$ ${inteiro},${centavos}/mês)`;
                    if (selecionados.length > 0) {
                        msg += ` incluindo os adicionais: ${selecionados.join(", ")}`;
                    }
                    btnZap.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(msg)}`;
                    btnZap.target = "_blank";
                    btnZap.rel = "noopener noreferrer";
                }
            }

            checkboxes.forEach((chk) =>
                chk.addEventListener("change", calcular),
            );
            calcular(); // Executa inicial

            // modo="selecionar" (usado em /contratar): não manda pra lugar
            // nenhum sozinho, quem escuta o evento decide (ex: avança pra
            // etapa de dados do pré-cadastro, já com o plano escolhido).
            if (modo === "selecionar" && btnSelecionar) {
                btnSelecionar.addEventListener("click", () => {
                    window.dispatchEvent(
                        new CustomEvent("zamtech:plano-selecionado", {
                            detail: {
                                nome: planName,
                                velocidade,
                                precoFinal: precoFinalAtual,
                                adicionais: selecionadosAtual,
                            },
                        }),
                    );
                });
            }
        });
    }

    // Roda no carregamento inicial
    initCalculadoraPlanos();
</script>

<style>
    /* ==========================================================================
       CARD DE PLANO — estrutura em 2 partes (igual à referência que você
       mandou): uma faixa com FOTO no topo (só ali, não o card inteiro) e um
       corpo CLARO embaixo, com uma "onda" SVG costurando as duas partes e
       o preço "sentado" bem em cima dessa costura.
       ========================================================================== */
    .card-plano-dinamico {
        position: relative;
        background-color: var(--color-white);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-signature);
        display: flex;
        flex-direction: column;
        transition: var(--transition-default), box-shadow 0.35s var(--ease-brand);
        box-shadow: var(--elevation-1);
    }

    .card-plano-dinamico:hover {
        transform: translateY(-4px);
        box-shadow: var(--elevation-3);
    }

    /* Card em destaque: mesmo formato, só ganha um contorno na cor
       secundária da marca pra se destacar no meio da grade — sem precisar
       mudar a estrutura toda nem sair da paleta azul da Zamtech. */
    .card-plano--featured {
        border: 2px solid var(--color-secondary);
        box-shadow: var(--elevation-2);
    }

    .card-plano--featured:hover {
        box-shadow: var(--elevation-glow);
    }

    /* Selo saltando pra fora do card, por cima da borda de cima — igual um
       "ticket" preso na parte de cima do cartão. Cores da própria marca
       (azul), nada de amarelo/laranja que não tem nada a ver com a
       identidade da Zamtech. */
    .card-badge {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        background: var(--gradient-brand);
        color: var(--color-white);
        font-size: var(--fs-caption);
        font-weight: 700;
        padding: var(--space-8) var(--space-16);
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        gap: 6px;
        box-shadow: var(--elevation-2);
        text-align: center;
        white-space: nowrap;
        border: 2px solid var(--color-white);
    }

    .card-badge svg {
        width: 14px;
        height: 14px;
        fill: var(--color-white);
        flex-shrink: 0;
    }

    /* FAIXA COM FOTO — cantos de cima arredondados e overflow escondido
       só aqui (não no card inteiro), assim o selo do badge consegue
       "vazar" pra fora da borda de cima sem ser cortado. */
    .hero-banner {
        position: relative;
        height: 224px;
        background-size: cover;
        background-position: center;
        /* --radius-signature é um shorthand de 4 cantos (28px 28px 28px
           4px, o "cantinho" característico da Zamtech) — não dá pra usar
           calc() em cima de um valor com 4 números de uma vez (isso
           invalida a propriedade inteira e o raio vira 0, que foi
           exatamente o bug do canto quadrado). Por isso os valores dos
           dois cantos de cima vêm fixos aqui, batendo com os mesmos 28px
           do canto superior do card. */
        border-radius: 28px 28px 0 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 var(--space-24);
        color: var(--color-white);
    }

    .hero-subtitle {
        font-size: var(--fs-caption);
        font-weight: 600;
        opacity: 0.95;
        display: block;
        margin-bottom: var(--space-4);
    }

    .hero-title {
        font-size: clamp(1.15rem, 4vw, 1.5rem);
        font-family: var(--font-display);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.3px;
        margin-bottom: var(--space-4);
    }

    .hero-tag {
        display: block;
        font-size: var(--fs-caption);
        font-weight: 600;
        opacity: 0.9;
    }

    /* Onda de transição entre a foto e o corpo claro do card */
    .curve-divider {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        /* Antes tinha 46px — a mesma altura da faixa branca à direita
           (onde o preço fica sentado). O número é mais alto que isso
           sozinho, então ele "estourava" pra cima e ficava colado direto
           na foto, sem respiro nenhum entre o valor e a imagem. Aumentando
           essa faixa branca sobra espaço de verdade acima do preço. */
        height: 68px;
        pointer-events: none;
    }

    .curve-divider path {
        fill: var(--color-white);
    }

    /* Preço "sentado" em cima da onda — por isso o texto é escuro, não
       branco: ali embaixo já não tem mais foto, é a cor clara do corpo. */
    .price-box {
        position: absolute;
        bottom: 10px;
        right: var(--space-16);
        z-index: 2;
        text-align: right;
    }

    .price-main {
        color: var(--color-dark-blue);
        font-weight: 800;
        line-height: 1;
        display: flex;
        align-items: baseline;
        justify-content: flex-end;
    }

    .currency {
        font-size: var(--fs-sm);
        font-weight: 700;
        margin-right: 3px;
    }

    .val-inteiro {
        font-size: var(--fs-h2);
        font-weight: 900;
        font-family: var(--font-display);
        letter-spacing: -0.5px;
    }

    .price-fraction {
        display: flex;
        flex-direction: column;
        margin-left: 2px;
    }

    .val-centavos {
        font-size: var(--fs-sm);
        font-weight: 700;
    }

    .period {
        font-size: 11px;
        font-weight: 600;
        color: var(--color-gray-medium);
    }

    /* CORPO CLARO — o padding daqui tinha sumido porque eu usei
       "var(--space-20)", um token que não existe no seu global.css (só
       existem 4, 8, 12, 16, 24, 32, 48, 64). Uma var(--x) que não existe
       não "cai" pra zero por acaso — ela invalida a propriedade inteira,
       que aí volta pro valor inicial (padding: 0). Por isso ficou tudo
       espremido, sem respiro nenhum. */
    .card-body {
        padding: var(--space-24);
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        /* Mesmo motivo do hero-banner: os dois cantos de baixo do
           --radius-signature são 28px (direita) e 4px (esquerda) — fixos
           aqui em vez de calc() pelo mesmo bug do canto quadrado. */
        border-radius: 0 0 28px 4px;
    }

    .btn-whatsapp,
    .btn-selecionar-plano {
        width: 100%;
        background: var(--gradient-brand);
        color: var(--color-white);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-8);
    }

    .btn-whatsapp svg,
    .btn-selecionar-plano svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .btn-whatsapp:hover,
    .btn-selecionar-plano:hover {
        transform: translateY(-2px);
        box-shadow: var(--elevation-glow);
    }

    .card-plano--featured .btn-whatsapp,
    .card-plano--featured .btn-selecionar-plano {
        background: var(--color-dark-blue);
        color: var(--color-white);
    }

    /* RECURSOS */
    .resources-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
    }

    .resources-list li {
        display: flex;
        align-items: center;
        gap: var(--space-12);
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--color-dark-blue);
    }

    .resources-list img {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    /* ADICIONAIS / SWITCHES */
    .adicionais-container {
        background: var(--color-gray-light);
        border: 1px solid var(--color-border);
        padding: var(--space-16);
        border-radius: var(--radius-md);
    }

    .adicionais-title {
        display: block;
        font-size: var(--fs-caption);
        font-weight: 700;
        margin-bottom: var(--space-8);
        color: var(--color-secondary);
    }

    .adicional-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-8);
        gap: var(--space-16);
        color: var(--color-gray-dark);
    }

    .adicional-item:last-child {
        margin-bottom: 0;
    }

    .adicional-label {
        font-size: var(--fs-sm);
        font-weight: 500;
    }

    /* TOGGLE SWITCH CSS */
    .switch {
        position: relative;
        display: inline-block;
        width: 38px;
        height: 22px;
        flex-shrink: 0;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: 0.3s;
        border-radius: var(--radius-full);
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 16px;
        width: 16px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: var(--color-primary);
    }

    input:checked + .slider:before {
        transform: translateX(16px);
    }

    input:disabled + .slider {
        opacity: 1;
        cursor: not-allowed;
    }

    /* DESCRIÇÃO */
    .description-text {
        text-align: center;
        color: var(--color-gray-medium);
        font-size: var(--fs-sm);
        font-weight: 500;
        line-height: 1.4;
    }
</style>
