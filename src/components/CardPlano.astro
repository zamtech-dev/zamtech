---

interface Adicional {
    nome: string;
    preco: number;
    incluso?: boolean;
}

interface Props {
    nome: string;
    velocidade?: string;
    precoBase: number;

    descricao?: string;
    badge?: string;
    economia?: string;
    recursos?: string[];
    adicionais?: Adicional[];
    isFeatured?: boolean;

    imagemFundo?: string;

    posicaoFundo?: string;

    modo?: "whatsapp" | "selecionar";
}

const {
    nome,
    velocidade,
    precoBase,
    descricao,
    badge,
    economia,
    recursos = [],
    adicionais = [],
    isFeatured = false,
    imagemFundo = "/assets/img/backgrounds/background-internet-zamtech.webp",
    posicaoFundo = "center",
    modo = "whatsapp",
} = Astro.props;

const [inteiroInicial, centavosIniciais] = precoBase.toFixed(2).split(".");
---

<article
    class={`card-plano-dinamico ${isFeatured ? "card-plano--featured" : ""}`}
    data-preco-base={precoBase}
    data-nome-plano={nome}
    data-velocidade={velocidade}
    data-modo={modo}
>
    {
        badge && (
            <div class="card-badge">
                <svg viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                </svg>
                {badge}
            </div>
        )
    }

    <div
        class="hero-banner"
        style={`background-image: linear-gradient(to right, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.25) 45%, rgba(0, 0, 0, 0) 100%), url("${imagemFundo}"); background-position: ${posicaoFundo};`}
    >
        <span class="hero-subtitle">{nome}</span>
        {velocidade && <h3 class="hero-title">{velocidade}</h3>}
        {economia && <span class="hero-tag">{economia}</span>}

        <svg class="curve-divider" viewBox="0 0 360 65" preserveAspectRatio="none">
            <path d="M 0 35 C 40 35, 45 60, 85 60 C 130 60, 140 0, 185 0 L 360 0 L 360 65 L 0 65 Z" />
        </svg>

        <div class="price-box">
            <div class="price-main">
                <span class="currency">R$</span>
                <span class="val-inteiro">{inteiroInicial}</span>
                <div class="price-fraction">
                    <span class="val-centavos">,{centavosIniciais}</span>
                    <span class="period">/mês</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card-body">

        {
            modo === "whatsapp" ? (
                <a href="#" class="btn btn-primary btn-whatsapp">
                    Adquirir Plano
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            ) : (
                <button type="button" class="btn btn-primary btn-selecionar-plano">
                    Escolher este plano
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>
            )
        }

        {
            recursos.length > 0 && (
                <ul class="resources-list">
                    {recursos.map((rec) => (
                        <li>
                            <img src="/assets/icons/check-zamtech.svg" alt="Check" />
                            <span>{rec}</span>
                        </li>
                    ))}
                </ul>
            )
        }

        {
            adicionais.length > 0 && (
                <div class="adicionais-container">
                    <span class="adicionais-title">Turbine seu plano:</span>
                    {adicionais.map((item) => (
                        <div class="adicional-item">
                            <span class="adicional-label">{item.nome}</span>
                            <label class="switch">
                                <input
                                    type="checkbox"
                                    class="chk-adicional"
                                    data-preco={item.preco}
                                    data-nome={item.nome}
                                    checked={item.incluso}
                                    disabled={item.incluso}
                                />
                                <span class="slider" />
                            </label>
                        </div>
                    ))}
                </div>
            )
        }

        {descricao && <p class="description-text">{descricao}</p>}
    </div>
</article>

<script>
    function initCalculadoraPlanos() {
        const cards = document.querySelectorAll(".card-plano-dinamico");
        const whatsappPhone = "5527995057736";

        cards.forEach((card) => {
            const basePrice = parseFloat(
                card.getAttribute("data-preco-base") || "0",
            );
            const planName =
                card.getAttribute("data-nome-plano") || "Plano Zamtech";
            const velocidade = card.getAttribute("data-velocidade") || "";
            const modo = card.getAttribute("data-modo") || "whatsapp";

            const valInteiro = card.querySelector(".val-inteiro");
            const valCentavos = card.querySelector(".val-centavos");
            const btnZap = card.querySelector(
                ".btn-whatsapp",
            ) as HTMLAnchorElement | null;
            const btnSelecionar = card.querySelector(
                ".btn-selecionar-plano",
            ) as HTMLButtonElement | null;
            const checkboxes = card.querySelectorAll(
                ".chk-adicional",
            ) as NodeListOf<HTMLInputElement>;

            let precoFinalAtual = basePrice;
            let selecionadosAtual: string[] = [];

            function calcular() {
                let precoAtual = basePrice;
                let selecionados: string[] = [];

                checkboxes.forEach((chk) => {

                    if (chk.checked && !chk.disabled) {
                        const preco = parseFloat(
                            chk.getAttribute("data-preco") || "0",
                        );
                        const nome = chk.getAttribute("data-nome") || "";
                        precoAtual += preco;
                        if (preco > 0) selecionados.push(nome);
                    }
                });

                const [inteiro, centavos] = precoAtual.toFixed(2).split(".");
                if (valInteiro) valInteiro.textContent = inteiro;
                if (valCentavos) valCentavos.textContent = `,${centavos}`;

                precoFinalAtual = precoAtual;
                selecionadosAtual = selecionados;

                if (modo === "whatsapp" && btnZap) {

                    let msg = `Olá! Quero contratar o plano ${planName} (R$ ${inteiro},${centavos}/mês)`;
                    if (selecionados.length > 0) {
                        msg += ` incluindo os adicionais: ${selecionados.join(", ")}`;
                    }
                    btnZap.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(msg)}`;
                    btnZap.target = "_blank";
                    btnZap.rel = "noopener noreferrer";
                }
            }

            checkboxes.forEach((chk) =>
                chk.addEventListener("change", calcular),
            );
            calcular();

            if (modo === "selecionar" && btnSelecionar) {
                btnSelecionar.addEventListener("click", () => {
                    window.dispatchEvent(
                        new CustomEvent("zamtech:plano-selecionado", {
                            detail: {
                                nome: planName,
                                velocidade,
                                precoFinal: precoFinalAtual,
                                adicionais: selecionadosAtual,
                            },
                        }),
                    );
                });
            }
        });
    }

    initCalculadoraPlanos();
</script>

<style>

    .card-plano-dinamico {
        position: relative;
        background-color: var(--color-white);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-signature);
        display: flex;
        flex-direction: column;
        transition: var(--transition-default), box-shadow 0.35s var(--ease-brand);
        box-shadow: var(--elevation-1);
    }

    .card-plano-dinamico:hover {
        transform: translateY(-4px);
        box-shadow: var(--elevation-3);
    }

    .card-plano--featured {
        border: 2px solid var(--color-secondary);
        box-shadow: var(--elevation-2);
    }

    .card-plano--featured:hover {
        box-shadow: var(--elevation-glow);
    }

    .card-badge {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        background: var(--gradient-brand);
        color: var(--color-white);
        font-size: var(--fs-caption);
        font-weight: 700;
        padding: var(--space-8) var(--space-16);
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        gap: 6px;
        box-shadow: var(--elevation-2);
        text-align: center;
        white-space: nowrap;
        border: 2px solid var(--color-white);
    }

    .card-badge svg {
        width: 14px;
        height: 14px;
        fill: var(--color-white);
        flex-shrink: 0;
    }

    .hero-banner {
        position: relative;
        height: 224px;
        background-size: cover;
        background-position: center;

        border-radius: 28px 28px 0 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 var(--space-24);
        color: var(--color-white);
    }

    .hero-subtitle {
        font-size: var(--fs-caption);
        font-weight: 600;
        opacity: 0.95;
        display: block;
        margin-bottom: var(--space-4);
    }

    .hero-title {
        font-size: clamp(1.15rem, 4vw, 1.5rem);
        font-family: var(--font-display);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.3px;
        margin-bottom: var(--space-4);
    }

    .hero-tag {
        display: block;
        font-size: var(--fs-caption);
        font-weight: 600;
        opacity: 0.9;
    }

    .curve-divider {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;

        height: 68px;
        pointer-events: none;
    }

    .curve-divider path {
        fill: var(--color-white);
    }

    .price-box {
        position: absolute;
        bottom: 10px;
        right: var(--space-16);
        z-index: 2;
        text-align: right;
    }

    .price-main {
        color: var(--color-dark-blue);
        font-weight: 800;
        line-height: 1;
        display: flex;
        align-items: baseline;
        justify-content: flex-end;
    }

    .currency {
        font-size: var(--fs-sm);
        font-weight: 700;
        margin-right: 3px;
    }

    .val-inteiro {
        font-size: var(--fs-h2);
        font-weight: 900;
        font-family: var(--font-display);
        letter-spacing: -0.5px;
    }

    .price-fraction {
        display: flex;
        flex-direction: column;
        margin-left: 2px;
    }

    .val-centavos {
        font-size: var(--fs-sm);
        font-weight: 700;
    }

    .period {
        font-size: 11px;
        font-weight: 600;
        color: var(--color-gray-medium);
    }

    .card-body {
        padding: var(--space-24);
        display: flex;
        flex-direction: column;
        gap: var(--space-24);

        border-radius: 0 0 28px 4px;
    }

    .btn-whatsapp,
    .btn-selecionar-plano {
        width: 100%;
        background: var(--gradient-brand);
        color: var(--color-white);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-8);
    }

    .btn-whatsapp svg,
    .btn-selecionar-plano svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .btn-whatsapp:hover,
    .btn-selecionar-plano:hover {
        transform: translateY(-2px);
        box-shadow: var(--elevation-glow);
    }

    .card-plano--featured .btn-whatsapp,
    .card-plano--featured .btn-selecionar-plano {
        background: var(--color-dark-blue);
        color: var(--color-white);
    }

    .resources-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
    }

    .resources-list li {
        display: flex;
        align-items: center;
        gap: var(--space-12);
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--color-dark-blue);
    }

    .resources-list img {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .adicionais-container {
        background: var(--color-gray-light);
        border: 1px solid var(--color-border);
        padding: var(--space-16);
        border-radius: var(--radius-md);
    }

    .adicionais-title {
        display: block;
        font-size: var(--fs-caption);
        font-weight: 700;
        margin-bottom: var(--space-8);
        color: var(--color-secondary);
    }

    .adicional-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-8);
        gap: var(--space-16);
        color: var(--color-gray-dark);
    }

    .adicional-item:last-child {
        margin-bottom: 0;
    }

    .adicional-label {
        font-size: var(--fs-sm);
        font-weight: 500;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 38px;
        height: 22px;
        flex-shrink: 0;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: 0.3s;
        border-radius: var(--radius-full);
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 16px;
        width: 16px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: var(--color-primary);
    }

    input:checked + .slider:before {
        transform: translateX(16px);
    }

    input:disabled + .slider {
        opacity: 1;
        cursor: not-allowed;
    }

    .description-text {
        text-align: center;
        color: var(--color-gray-medium);
        font-size: var(--fs-sm);
        font-weight: 500;
        line-height: 1.4;
    }
</style>
