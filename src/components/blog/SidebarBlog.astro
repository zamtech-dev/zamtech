---
import { formatarDataBr, type ArtigoWP, type CategoriaWP } from '../../lib/wordpress';

interface Props {
    categorias: CategoriaWP[];
    recentes: ArtigoWP[];
    categoriaAtiva?: string;
}

const { categorias, recentes, categoriaAtiva = '' } = Astro.props;
---

<aside class="blog-sidebar">
    <div class="sidebar-card">
        <h2 class="sidebar-card-titulo">Ordenar por</h2>
        <div class="filtro-tabs" id="blog-filtro-tabs">
            <button type="button" class="filtro-tab ativo" data-ordem="recentes">Mais recentes</button>
            <button type="button" class="filtro-tab" data-ordem="populares">Mais populares</button>
        </div>
    </div>

    <div class="sidebar-card">
        <h2 class="sidebar-card-titulo">Categorias</h2>
        <ul class="categoria-lista">
            <li>
                <a href="/blog/" class={categoriaAtiva === '' ? 'ativo' : ''}>Todas</a>
            </li>
            {categorias.map((cat) => (
                <li>
                    <a href={`/blog/categoria/${cat.slug}/`} class={categoriaAtiva === cat.slug ? 'ativo' : ''}>
                        <span class="categoria-nome">{cat.nome}</span>
                        <span class="categoria-contagem">{cat.totalArtigos}</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>

    {recentes.length > 0 && (
        <div class="sidebar-card">
            <h2 class="sidebar-card-titulo">Mais recentes</h2>
            <ul class="sidebar-artigos-recentes">
                {recentes.map((artigo) => (
                    <li class="sidebar-artigo-item">
                        <a href={`/blog/${artigo.slug}/`}>
                            <span class="sidebar-artigo-imagem">
                                {artigo.imagemCapa && <img src={artigo.imagemCapa} alt="" loading="lazy" />}
                            </span>
                            <span class="sidebar-artigo-texto">
                                <span class="sidebar-artigo-titulo">{artigo.titulo}</span>
                                <span class="sidebar-artigo-data">{formatarDataBr(artigo.dataPublicacao)}</span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    )}

    <div class="sidebar-card sidebar-card-institucional">
        <div class="sidebar-card-banner">
            <img src="https://zamtech.com.br/cms/wp-content/uploads/2026/09/mulher-encantada-assiste-a-um-webinar-interessante-em-um-laptop-portatil.jpg" alt="" loading="lazy" />
        </div>
        <div class="sidebar-card-corpo">
            <h2 class="sidebar-card-titulo">Quem é a Zamtech?</h2>
            <p>Internet fibra óptica de verdade, com suporte que responde e planos pensados pra sua casa ou pra sua empresa.</p>
            <a href="/sobre" class="sidebar-card-link">Conhecer a Zamtech &rarr;</a>
        </div>
    </div>

    <div class="sidebar-card sidebar-card-institucional">
        <div class="sidebar-card-banner">
            <img src="https://zamtech.com.br/cms/wp-content/uploads/2026/09/duas-amigas-ao-ar-livre-com-smartphone-e-fones-de-ouvido_23-2148655919.jpg" alt="" loading="lazy" />
        </div>
        <div class="sidebar-card-corpo">
            <h2 class="sidebar-card-titulo">Pra sua casa</h2>
            <p>Planos de internet residencial com Wi-Fi de verdade em todo cômodo.</p>
            <a href="/planos-residenciais" class="sidebar-card-link">Ver planos residenciais &rarr;</a>
        </div>
    </div>

    <div class="sidebar-card sidebar-card-institucional">
        <div class="sidebar-card-banner">
            <img src="https://zamtech.com.br/cms/wp-content/uploads/2026/09/mulher-em-hammock-a-trabalhar_23-2151205508.jpg" alt="" loading="lazy" />
        </div>
        <div class="sidebar-card-corpo">
            <h2 class="sidebar-card-titulo">Pra sua empresa</h2>
            <p>Link dedicado, estabilidade e suporte prioritário pro seu negócio não parar.</p>
            <a href="/planos-empresariais" class="sidebar-card-link">Ver planos empresariais &rarr;</a>
        </div>
    </div>
</aside>

<script>
    const tabsOrdem = document.getElementById('blog-filtro-tabs');
    const grade = document.querySelector<HTMLElement>('.blog-grid');

    if (tabsOrdem && grade) {
        tabsOrdem.addEventListener('click', (ev) => {
            const botao = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-ordem]');
            if (!botao) return;

            tabsOrdem.querySelectorAll('.filtro-tab').forEach((b) => b.classList.remove('ativo'));
            botao.classList.add('ativo');

            const cards = Array.from(grade.querySelectorAll<HTMLElement>('.blog-card'));
            const ordem = botao.dataset.ordem;

            cards.sort((a, b) => {
                if (ordem === 'populares') {
                    const pontosA = Number(a.dataset.curtidas || 0) + Number(a.dataset.comentarios || 0);
                    const pontosB = Number(b.dataset.curtidas || 0) + Number(b.dataset.comentarios || 0);
                    return pontosB - pontosA;
                }
                return new Date(b.dataset.data || 0).getTime() - new Date(a.dataset.data || 0).getTime();
            });

            cards.forEach((card) => grade.appendChild(card));
        });
    }
</script>
