---
import { formatarDataBr, type ArtigoWP, type CategoriaWP } from '../../lib/wordpress';

interface Props {
    categorias: CategoriaWP[];
    recentes: ArtigoWP[];
    categoriaAtiva?: string;
}

const { categorias, recentes, categoriaAtiva = '' } = Astro.props;
---

<aside class="blog-sidebar">
    <div class="sidebar-card">
        <h2 class="sidebar-card-titulo">Pesquisar artigos</h2>
        <div class="busca-campo">
            <input
                type="text"
                id="blog-busca-input"
                class="busca-input"
                placeholder="Do que você precisa saber?"
                autocomplete="off"
            />
            <button type="button" class="busca-botao" aria-label="Pesquisar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
        </div>
        <div id="blog-busca-resultados" class="busca-resultados" hidden></div>
    </div>

    <div class="sidebar-card">
        <h2 class="sidebar-card-titulo">Ordenar por</h2>
        <div class="filtro-tabs" id="blog-filtro-tabs">
            <button type="button" class="filtro-tab ativo" data-ordem="recentes">Mais recentes</button>
            <button type="button" class="filtro-tab" data-ordem="populares">Mais populares</button>
        </div>
    </div>

    <div class="sidebar-card">
        <h2 class="sidebar-card-titulo">Categorias</h2>
        <ul class="categoria-lista">
            <li>
                <a href="/blog/" class={categoriaAtiva === '' ? 'ativo' : ''}>Todas</a>
            </li>
            {categorias.map((cat) => (
                <li>
                    <a href={`/blog/categoria/${cat.slug}/`} class={categoriaAtiva === cat.slug ? 'ativo' : ''}>
                        <span class="categoria-nome">{cat.nome}</span>
                        <span class="categoria-contagem">{cat.totalArtigos}</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>

    {recentes.length > 0 && (
        <div class="sidebar-card">
            <h2 class="sidebar-card-titulo">Mais recentes</h2>
            <ul class="sidebar-artigos-recentes">
                {recentes.map((artigo) => (
                    <li class="sidebar-artigo-item">
                        <a href={`/blog/${artigo.slug}/`}>
                            <span class="sidebar-artigo-imagem">
                                {artigo.imagemCapa && <img src={artigo.imagemCapa} alt="" loading="lazy" />}
                            </span>
                            <span class="sidebar-artigo-texto">
                                <span class="sidebar-artigo-titulo">{artigo.titulo}</span>
                                <span class="sidebar-artigo-data">{formatarDataBr(artigo.dataPublicacao)}</span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    )}

    <div class="sidebar-card sidebar-card-destaque sidebar-card-com-imagem">
        <div class="sidebar-card-banner">
            <img src="/assets/img/sobre-imgs/01-conheca-a-zamtech-fibra-optica.webp" alt="" loading="lazy" />
        </div>
        <div class="sidebar-card-corpo">
            <h2 class="sidebar-card-titulo">Quem é a Zamtech?</h2>
            <p>Internet fibra óptica de verdade, com suporte que responde e planos pensados pra sua casa ou pra sua empresa.</p>
            <a href="/sobre" class="sidebar-card-link">Conhecer a Zamtech &rarr;</a>
        </div>
    </div>

    <div class="sidebar-card sidebar-card-com-imagem">
        <div class="sidebar-card-banner">
            <img src="/assets/img/backgrounds/wallpaper-planos-residenciais.webp" alt="" loading="lazy" />
        </div>
        <div class="sidebar-card-corpo">
            <h2 class="sidebar-card-titulo">Pra sua casa</h2>
            <p>Planos de internet residencial com Wi-Fi de verdade em todo cômodo.</p>
            <a href="/planos-residenciais" class="sidebar-card-link">Ver planos residenciais &rarr;</a>
        </div>
    </div>

    <div class="sidebar-card sidebar-card-escura sidebar-card-com-imagem">
        <div class="sidebar-card-banner">
            <img src="/assets/img/backgrounds/background-planos-empresariais.jpg" alt="" loading="lazy" />
        </div>
        <div class="sidebar-card-corpo">
            <h2 class="sidebar-card-titulo">Pra sua empresa</h2>
            <p>Link dedicado, estabilidade e suporte prioritário pro seu negócio não parar.</p>
            <a href="/planos-empresariais" class="sidebar-card-link">Ver planos empresariais &rarr;</a>
        </div>
    </div>
</aside>

<script>
    // --- Pesquisa (busca no arquivo /blog/busca.json gerado no build) ---
    type ItemBusca = { titulo: string; resumo: string; slug: string; categoria: string };

    let indiceBusca: ItemBusca[] | null = null;
    let carregandoIndice: Promise<ItemBusca[]> | null = null;

    // Tira acento pra comparação de busca (ex: "conexao" acha "conexão").
    // Monta o intervalo de "marcas de acento combinando" por código, em vez
    // de escrever o caractere Unicode direto no meio do regex — assim não
    // tem risco de esse trecho ser salvo/exibido errado em algum editor.
    const REGEX_DIACRITICOS = new RegExp(
        `[${String.fromCharCode(0x0300)}-${String.fromCharCode(0x036f)}]`,
        'g'
    );

    function normalizar(texto: string): string {
        return texto.toLowerCase().normalize('NFD').replace(REGEX_DIACRITICOS, '');
    }

    async function carregarIndiceBusca(): Promise<ItemBusca[]> {
        if (indiceBusca) return indiceBusca;
        if (!carregandoIndice) {
            carregandoIndice = fetch('/blog/busca.json')
                .then((r) => (r.ok ? r.json() : []))
                .catch(() => []);
        }
        indiceBusca = await carregandoIndice;
        return indiceBusca;
    }

    const inputBusca = document.getElementById('blog-busca-input') as HTMLInputElement | null;
    const resultadosBusca = document.getElementById('blog-busca-resultados') as HTMLDivElement | null;

    if (inputBusca && resultadosBusca) {
        let temporizador: ReturnType<typeof setTimeout>;

        inputBusca.addEventListener('input', () => {
            clearTimeout(temporizador);
            const termo = inputBusca.value.trim();

            if (termo.length < 2) {
                resultadosBusca.hidden = true;
                resultadosBusca.innerHTML = '';
                return;
            }

            temporizador = setTimeout(async () => {
                const itens = await carregarIndiceBusca();
                const termoNormalizado = normalizar(termo);

                const encontrados = itens
                    .filter(
                        (item) =>
                            normalizar(item.titulo).includes(termoNormalizado) ||
                            normalizar(item.resumo).includes(termoNormalizado) ||
                            normalizar(item.categoria).includes(termoNormalizado)
                    )
                    .slice(0, 6);

                if (encontrados.length === 0) {
                    resultadosBusca.innerHTML = '<p class="busca-vazio">Nada encontrado com esse termo.</p>';
                } else {
                    resultadosBusca.innerHTML = encontrados
                        .map(
                            (item) => `
                                <a href="/blog/${item.slug}/" class="busca-resultado-item">
                                    <span>${item.titulo}</span>
                                    ${item.categoria ? `<span class="busca-resultado-categoria">${item.categoria}</span>` : ''}
                                </a>
                            `
                        )
                        .join('');
                }
                resultadosBusca.hidden = false;
            }, 200);
        });

        document.addEventListener('click', (ev) => {
            if (!(ev.target instanceof Node)) return;
            if (!inputBusca.contains(ev.target) && !resultadosBusca.contains(ev.target)) {
                resultadosBusca.hidden = true;
            }
        });
    }

    // --- Ordenar (Mais recentes / Mais populares) ---
    // Reordena os cards que já estão na página (não busca nada de novo) —
    // "populares" aqui é curtidas + comentários somados.
    const tabsOrdem = document.getElementById('blog-filtro-tabs');
    const grade = document.querySelector<HTMLElement>('.blog-grid');

    if (tabsOrdem && grade) {
        tabsOrdem.addEventListener('click', (ev) => {
            const botao = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-ordem]');
            if (!botao) return;

            tabsOrdem.querySelectorAll('.filtro-tab').forEach((b) => b.classList.remove('ativo'));
            botao.classList.add('ativo');

            const cards = Array.from(grade.querySelectorAll<HTMLElement>('.blog-card'));
            const ordem = botao.dataset.ordem;

            cards.sort((a, b) => {
                if (ordem === 'populares') {
                    const pontosA = Number(a.dataset.curtidas || 0) + Number(a.dataset.comentarios || 0);
                    const pontosB = Number(b.dataset.curtidas || 0) + Number(b.dataset.comentarios || 0);
                    return pontosB - pontosA;
                }
                return new Date(b.dataset.data || 0).getTime() - new Date(a.dataset.data || 0).getTime();
            });

            cards.forEach((card) => grade.appendChild(card));
        });
    }
</script>
