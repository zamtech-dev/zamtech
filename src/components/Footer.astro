<style>
    /* ==========================================================================
       RODAPÉ (FOOTER) — estilo compacto, inspirado no rodapé da Apple:
       colunas de links pequenos, bloco de contato reduzido logo abaixo, e
       uma última linha bem pequena só com copyright. Antes o rodapé tinha
       poucos links (bem grandes) e vários links da Zamtech não apareciam
       aqui — agora toda página nova do site tem seu lugar aqui.
       ========================================================================== */
    .main-footer {
        position: relative;
        background-color: var(--color-gray-dark);
        color: var(--color-white);
        padding: var(--space-48) 0 var(--space-24) 0;
        font-family: var(--font-text);
        overflow: hidden;
    }

    /* Fio de sinal assinatura Zamtech no topo do rodapé, ecoando o header */
    .main-footer::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gradient-signal);
    }

    .footer-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Logo no topo */
    .footer-logo-row {
        margin-bottom: var(--space-32);
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .footer-main-logo {
        max-width: 7rem;
        height: auto;
    }

    /* GRADE DE LINKS — 4 colunas, texto pequeno (estilo Apple) */
    .footer-links-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-24);
        width: 100%;
        margin-bottom: var(--space-24);
    }

    .footer-link-col ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    .footer-link-title {
        font-family: var(--font-display);
        font-size: var(--fs-sm);
        font-weight: 700;
        margin-bottom: var(--space-12);
        color: var(--color-white);
    }

    .footer-link-col a {
        font-size: var(--fs-sm);
        color: rgba(255, 255, 255, 0.65);
        transition: var(--transition-default);
    }

    .footer-link-col a:hover {
        color: var(--color-white);
    }

    /* Divisor fino entre a grade de links e o bloco de contato */
    .footer-divider {
        width: 100%;
        border: none;
        height: 1px;
        background: rgba(255, 255, 255, 0.12);
        margin-bottom: var(--space-32);
    }

    /* BLOCO DE CONTATO E REDES — igual ao parágrafo pequeno de endereço/telefone da Apple */
    .footer-info-block {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-24);
        width: 100%;
        margin-bottom: var(--space-16);
    }

    .footer-info-col {
        display: flex;
        flex-direction: column;
    }

    .footer-info-title {
        font-family: var(--font-display);
        font-size: var(--fs-caption);
        font-weight: 700;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: var(--space-8);
    }

    .footer-username {
        font-size: var(--fs-sm);
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: var(--space-8);
        display: block;
    }

    .social-links-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-16);
    }

    .social-links-row img {
        width: 1rem;
        height: 1rem;
        object-fit: contain;
        opacity: 0.75;
        transition: var(--transition-default);
    }

    .social-links-row a:hover img {
        opacity: 1;
    }

    .footer-info-col p {
        font-size: var(--fs-sm);
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.65);
    }

    .footer-info-col p a {
        color: rgba(255, 255, 255, 0.85);
    }

    .footer-info-col p a:hover {
        color: var(--color-white);
    }

    /* LINHA FINAL — bem pequena, só copyright (igual ao rodapé da Apple) */
    .footer-bottom-bar {
        width: 100%;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: var(--space-16);
    }

    .footer-bottom-bar p {
        font-size: var(--fs-sm);
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
    }

    /* ==========================================================================
       RESPONSIVIDADE
       ========================================================================== */
    @media (max-width: 900px) {
        .footer-links-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-24) var(--space-32);
        }

        .footer-info-block {
            grid-template-columns: 1fr;
            gap: var(--space-24);
        }
    }

    @media (max-width: 560px) {
        .footer-links-grid {
            grid-template-columns: 1fr;
            gap: var(--space-24);
        }
    }
</style>
