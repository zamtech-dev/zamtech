---
// Pega a URL atual para marcar o link ativo
const currentPath = Astro.url.pathname;

const links = [
  { name: "Regulamentos", href: "/regulamentos" },
  { name: "Indique e Ganhe", href: "/regulamento-indique-e-ganhe" },
  { name: "Política de Privacidade", href: "/politica-de-privacidade" },
  { name: "Termos de Uso", href: "/termos-de-uso" },
  { name: "Contrato de Adesão", href: "/termos-de-contrato" },
  { name: "Termos de Adesão", href: "/termos-de-adesao" },
  { name: "Compromissos Institucionais", href: "/compromisso" },
  { name: "Vacinação - (COVID-19)", href: "/vacinacao" },
];
---

<aside class="sidebar">
  <h2>Assuntos Regulamentares</h2>
  <nav>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class={currentPath === link.href ? "active" : ""}
            >
              {link.name}
              <span class="arrow">&rsaquo;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  .sidebar {
    background: linear-gradient(
      180deg,
      rgba(245, 245, 245, 1) 0%,
      rgba(245, 245, 245, 0.6) 51%,
      rgba(245, 245, 245, 0) 100%
    );
    width: 100%;
    max-width: 300px;
    padding: 4rem 4rem 3rem 3rem;
    border-radius: var(--radius-lg);
    border-right: 1px solid var(--color-gray-light);
  }

  .sidebar h2 {
    font-size: 1.125rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
    color: var(--color-gray-dark);
  }

  .sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar li {
    border-bottom: 1px solid var(--color-gray-light);
  }

  .sidebar a {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0 1rem 0.9rem;
    text-decoration: none;
    color: var(--color-gray-medium);
    font-weight: 500;
    transition: color 0.2s ease, padding-left 0.2s var(--ease-brand);
  }

  .sidebar a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    border-radius: var(--radius-full);
    background: var(--gradient-brand);
    transition: height 0.2s var(--ease-brand);
  }

  .sidebar a:hover {
    color: var(--color-primary);
    padding-left: 1.1rem;
  }

  .sidebar a:hover::before,
  .sidebar a.active::before {
    height: 70%;
  }

  .sidebar a.active {
    color: var(--color-primary);
    font-weight: bold;
    padding-left: 1.1rem;
  }

  .arrow {
    font-size: 1.2rem;
  }

  /* Responsivo: vira topo em telas pequenas */
  @media (max-width: 768px) {
    .sidebar {
      max-width: 100%;
      border-right: none;
      border-bottom: 1px solid #e5e7eb;
      padding-right: 5rem;
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
  }
</style>
